#!/bin/sh
# login-warnings
#
# Runs the login warning checks, shows their results, and switches checks on and off.
#
# A check is registered by a file /etc/login-warnings.d/<check> whose first line is the
# command that runs it, for example pg-collation-check; /etc/login-warnings.d/<check>.off is a
# check that is switched off. Every check accepts --quiet and --trigger, writes its result to
# /run/login-warnings/<check> and may keep hidden files /run/login-warnings/.<check>.*.
# /etc/profile.d/login-warnings.sh runs "login-warnings show" in every interactive login shell.
#
# All enabled checks run after every boot (login-warnings.service), after every dpkg run
# (/etc/dpkg/dpkg.cfg.d/login-warnings) and after every apt update
# (/etc/apt/apt.conf.d/80login-warnings). If a check fails or cannot be run, the exit status
# is 1.
#
# After an apt update and when run by hand, it also asks GitHub which release is the latest
# (the redirect of /releases/latest, nothing is downloaded) and keeps the answer in
# /var/lib/login-warnings/latest-release. The display then names a newer release, and its
# closing line says when the latest release was last checked. A login never goes online.
#
# Usage: login-warnings [--quiet] [--trigger boot|dpkg|apt|manual]
#                                     run every enabled check, then show the results
#        login-warnings show          show the results of every enabled check (any user)
#        login-warnings list          every registered check and whether it is on
#        login-warnings enable <check>
#        login-warnings disable <check>
#        login-warnings update        install the latest release from GitHub
#        login-warnings --version
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

# Version of the whole repository; it must match the newest section in CHANGELOG.md.
VERSION="3.3.2"

CONF=/etc/login-warnings.d
DIR=/run/login-warnings
# The archive of the newest GitHub release; the README installs from the same address.
RELEASE_URL=https://github.com/MarcFauser/login-warnings/releases/latest/download/login-warnings.tar.gz
# Redirects to .../releases/tag/v<version> of the newest release.
LATEST_PAGE=https://github.com/MarcFauser/login-warnings/releases/latest
SRC=/usr/local/src/login-warnings
# "<version> <seconds since the epoch>" of the last successful look at LATEST_PAGE.
LATEST=/var/lib/login-warnings/latest-release

usage()
{
    cat >&2 <<'EOF'
Usage: login-warnings [--quiet] [--trigger boot|dpkg|apt|manual]
       login-warnings show
       login-warnings list
       login-warnings enable <check>
       login-warnings disable <check>
       login-warnings update
       login-warnings --version
EOF
    exit 2
}

need_root()
{
    if [ "$(id -u)" -ne 0 ]
    then
        echo "Please run as root." >&2
        exit 1
    fi
}

valid_name()
{
    case $1 in
        '' | *[!a-z0-9-]*)
            echo "login-warnings: invalid check name '$1' (lowercase letters, digits and '-')." >&2
            exit 2
            ;;
    esac
}

# Enabled checks, one name per line. A name never contains a dot, so <check>.off (switched
# off) and <check>.tmp (being written) are skipped.
enabled()
{
    for reg in "$CONF"/*
    do
        name=${reg##*/}
        case $name in
            *.*) continue ;;
        esac
        if [ -f "$reg" ]
        then
            echo "$name"
        fi
    done
}

boot_time()
{
    date -d "@$(awk '/^btime/ { print $2 }' /proc/stat)" '+%Y-%m-%d %H:%M:%S %:z' 2>/dev/null
}

# The text, filled up with dashes to 72 columns.
frame_line()
{
    printf '%s\n' "$1" | awk '{ s = $0; while (length(s) < 72) s = s "-"; print s }'
}

# Is $1 a higher version than $2?
newer()
{
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# Asks GitHub for the latest release and stores it; on failure the old answer stays, and the
# closing line of the display shows its age.
check_release()
{
    location=""
    if command -v curl >/dev/null 2>&1
    then
        location=$(curl -sS -o /dev/null --max-time 10 -w '%{redirect_url}' "$LATEST_PAGE" 2>/dev/null)
    elif command -v wget >/dev/null 2>&1
    then
        # wget is told not to follow the redirect and exits with 8; the header is what counts.
        location=$(wget -q -S --max-redirect=0 --timeout=10 -O /dev/null "$LATEST_PAGE" 2>&1 \
            | awk '/^ *[Ll]ocation: / { print $2; exit }')
    fi
    tag=${location##*/}
    latest=${tag#v}
    case $tag in
        v[0-9]*) ;;
        *) latest="" ;;
    esac
    case $latest in
        '' | *[!0-9.]*)
            echo "login-warnings: could not read the latest release from $LATEST_PAGE." >&2
            return 0
            ;;
    esac
    mkdir -p -m 0755 "${LATEST%/*}"
    printf '%s %s\n' "$latest" "$(date '+%s')" > "$LATEST.tmp.$$"
    chmod 0644 "$LATEST.tmp.$$"
    mv -f "$LATEST.tmp.$$" "$LATEST"
}

# One section per enabled check inside a frame, separated by empty lines. Each check writes
# its own section; a check without a result gets one here. A newer release gets a section of
# its own, and the closing line says when the latest release was checked.
show()
{
    names=$(enabled)
    if [ -z "$names" ]
    then
        return 0
    fi
    orange=$(printf '\033[38;5;208m')
    reset=$(printf '\033[0m')
    latest_version=""
    latest_checked=""
    if [ -f "$LATEST" ]
    then
        read -r latest_version latest_checked < "$LATEST"
    fi
    case $latest_version in
        '' | *[!0-9.]*) latest_version="" ;;
    esac
    case $latest_checked in
        '' | *[!0-9]*) latest_checked="" ;;
    esac
    echo
    frame_line "----- login-warnings v$VERSION "
    first=1
    for name in $names
    do
        if [ "$first" -eq 0 ]
        then
            echo
        fi
        first=0
        if [ -f "$DIR/$name" ] && [ -s "$DIR/$name" ]
        then
            cat "$DIR/$name"
        else
            printf '%s%s: NO RESULT\n  no result since boot (%s)\n  run: %s%s\n' \
                "$orange" "$name" "$(boot_time)" "$(head -n 1 "$CONF/$name")" "$reset"
        fi
    done
    if [ -n "$latest_version" ] && newer "$latest_version" "$VERSION"
    then
        echo
        printf '%slogin-warnings: v%s available\n  installed: v%s\n  update: login-warnings update%s\n' \
            "$orange" "$latest_version" "$VERSION" "$reset"
    fi
    echo
    if [ -n "$latest_checked" ]
    then
        frame_line "----- latest release checked $(date -d "@$latest_checked" '+%Y-%m-%d %H:%M:%S %:z') "
    else
        frame_line "----- latest release not checked yet "
    fi
}

# Runs one enabled check quietly; returns 1 if it cannot be run or fails.
run_one()
{
    cmd=$(head -n 1 "$CONF/$1")
    case $cmd in
        '' | *[!A-Za-z0-9._-]*)
            echo "login-warnings: $CONF/$1: the first line is not a command name." >&2
            return 1
            ;;
    esac
    if ! command -v "$cmd" >/dev/null 2>&1
    then
        echo "login-warnings: $1: command $cmd not found." >&2
        return 1
    fi
    timeout 120 "$cmd" --quiet --trigger "$trigger"
    rc=$?
    if [ "$rc" -eq 124 ]
    then
        echo "login-warnings: $1: $cmd did not finish within 120 seconds." >&2
        return 1
    fi
    if [ "$rc" -ne 0 ]
    then
        echo "login-warnings: $1: $cmd exited with status $rc." >&2
        return 1
    fi
    return 0
}

list()
{
    found=0
    for reg in "$CONF"/*
    do
        name=${reg##*/}
        case $name in
            *.off) state=off; name=${name%.off} ;;
            *.*) continue ;;
            *) state=on ;;
        esac
        if [ ! -f "$reg" ]
        then
            continue
        fi
        if [ "$found" -eq 0 ]
        then
            printf '%-16s %-5s %s\n' CHECK STATE COMMAND
            found=1
        fi
        printf '%-16s %-5s %s\n' "$name" "$state" "$(head -n 1 "$reg")"
    done
    if [ "$found" -eq 0 ]
    then
        echo "No checks registered in $CONF."
    fi
}

enable()
{
    need_root
    valid_name "$1"
    if [ -f "$CONF/$1" ]
    then
        echo "$1 is already on."
    elif [ -f "$CONF/$1.off" ]
    then
        mv -f "$CONF/$1.off" "$CONF/$1"
    elif command -v "$1-check" >/dev/null 2>&1
    then
        mkdir -p -m 0755 "$CONF"
        printf '%s-check\n' "$1" > "$CONF/$1.tmp"
        chmod 0644 "$CONF/$1.tmp"
        mv -f "$CONF/$1.tmp" "$CONF/$1"
    else
        echo "Unknown check: $1 (neither $CONF/$1.off nor a command $1-check exists)." >&2
        exit 1
    fi
    trigger=manual
    status=0
    run_one "$1" || status=1
    cat "$DIR/$1" 2>/dev/null
    exit $status
}

disable()
{
    need_root
    valid_name "$1"
    if [ -f "$CONF/$1" ]
    then
        mv -f "$CONF/$1" "$CONF/$1.off"
    elif [ -f "$CONF/$1.off" ]
    then
        echo "$1 is already off."
    else
        echo "Unknown check: $1 (no $CONF/$1)." >&2
        exit 1
    fi
    # The login shows only enabled checks; the old result goes so nothing stale stays behind.
    rm -f "$DIR/$1" "$DIR/.$1."*
    echo "$1 is off. Switch it on again: login-warnings enable $1"
}

# Downloads the latest release next to $SRC, shows what changed since the installed version,
# puts it in place of $SRC and runs its install.sh. Does nothing if the release is not newer.
update()
{
    need_root
    new=$SRC.new
    rm -rf "$new"
    mkdir -p -m 0755 "$new"
    echo "Downloading $RELEASE_URL"
    if command -v wget >/dev/null 2>&1
    then
        wget -q -O "$new/release.tar.gz" "$RELEASE_URL" || { rm -rf "$new"; echo "Download failed." >&2; exit 1; }
    elif command -v curl >/dev/null 2>&1
    then
        curl -fsSL -o "$new/release.tar.gz" "$RELEASE_URL" || { rm -rf "$new"; echo "Download failed." >&2; exit 1; }
    else
        rm -rf "$new"
        echo "Neither wget nor curl is installed: apt install wget" >&2
        exit 1
    fi
    if ! tar -xzf "$new/release.tar.gz" -C "$new" || [ ! -f "$new/login-warnings/install.sh" ]
    then
        rm -rf "$new"
        echo "The downloaded archive does not contain login-warnings/install.sh." >&2
        exit 1
    fi
    latest=$(sed -n 's/^VERSION="\([^"]*\)"$/\1/p' "$new/login-warnings/login-warnings")
    case $latest in
        '' | *[!0-9.]*)
            rm -rf "$new"
            echo "The downloaded archive has no valid version." >&2
            exit 1
            ;;
    esac
    if [ "$latest" = "$VERSION" ]
    then
        rm -rf "$new"
        echo "login-warnings v$VERSION is up to date."
        exit 0
    fi
    if ! newer "$latest" "$VERSION"
    then
        rm -rf "$new"
        echo "login-warnings v$VERSION is newer than the latest release v$latest; nothing changed."
        exit 0
    fi
    echo "Updating login-warnings v$VERSION -> v$latest. Changes:"
    # The CHANGELOG sections above the installed version.
    awk -v cur="$VERSION" '/^## \[/ { if (index($0, "## [" cur "]") == 1) exit; p = 1 } p { print "  " $0 }' \
        "$new/login-warnings/CHANGELOG.md"
    rm -rf "$SRC.old"
    if [ -e "$SRC" ]
    then
        mv "$SRC" "$SRC.old"
    fi
    mv "$new/login-warnings" "$SRC"
    rm -rf "$new" "$SRC.old"
    echo
    exec bash "$SRC/install.sh"
}

case ${1:-} in
    update)
        [ $# -eq 1 ] || usage
        update
        # update ends in exec or exit; never fall through to the run below.
        exit 1
        ;;
    show)
        [ $# -eq 1 ] || usage
        show
        exit 0
        ;;
    list)
        [ $# -eq 1 ] || usage
        list
        exit 0
        ;;
    enable)
        [ $# -eq 2 ] || usage
        enable "$2"
        ;;
    disable)
        [ $# -eq 2 ] || usage
        disable "$2"
        exit 0
        ;;
    --version)
        [ $# -eq 1 ] || usage
        echo "login-warnings v$VERSION"
        exit 0
        ;;
esac

quiet=0
trigger=manual
while [ $# -gt 0 ]
do
    case $1 in
        --quiet) quiet=1 ;;
        --trigger) shift; trigger=${1:-} ;;
        *) usage ;;
    esac
    shift
done
case $trigger in
    boot | dpkg | apt | manual) ;;
    *) usage ;;
esac

need_root
status=0
for name in $(enabled)
do
    run_one "$name" || status=1
done

# Once a day after the apt update, and by hand; never at boot or after dpkg, where the network
# may be missing or the check would run several times in a row.
case $trigger in
    apt | manual) check_release ;;
esac

if [ "$quiet" -eq 0 ]
then
    show
fi
exit $status
