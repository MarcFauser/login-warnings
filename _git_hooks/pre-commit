#!/bin/sh
# Two checks before every commit, both on the index, which is what gets committed:
# 1. Every file that starts with "#!" has LF line endings. With CRLF the kernel takes the
#    CR as part of the interpreter name ("/bin/bash^M: bad interpreter") and the script
#    does not start on the server. Git does not convert line endings here (* -text).
# 2. Every commit raises the version: CHANGELOG.md must be part of the commit, its newest
#    version must differ from the one in HEAD, and VERSION in pg-collation-fix must match it.

script=pg-collation-fix

abort()
{
    echo "" >&2
    echo "  ABORT: $1" >&2
    echo "  -> $2" >&2
    echo "" >&2
    exit 1
}

crlf_files=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file
do
    if [ "$(git show ":$file" | head -c 2)" = "#!" ]
    then
        cr_count=$(git show ":$file" | tr -dc '\015' | wc -c)
        if [ "$cr_count" -gt 0 ]
        then
            echo "    $file"
        fi
    fi
done)

if [ -n "$crlf_files" ]
then
    echo "" >&2
    echo "  Scripts with CRLF line endings:" >&2
    echo "$crlf_files" >&2
    abort "these scripts would not start on Linux." "convert them to LF and stage them again"
fi

staged=$(git diff --cached --name-only)
how="add a new version section to CHANGELOG.md and set VERSION in $script"

echo "$staged" | grep -q '^CHANGELOG\.md$' || abort "CHANGELOG.md is not part of this commit." "$how"

new_version=$(git show :CHANGELOG.md | sed -n 's/^## \[\([0-9][0-9.]*\)\].*/\1/p' | head -n 1)
script_version=$(git show ":$script" | sed -n 's/^VERSION="\([^"]*\)"$/\1/p')
old_version=$(git show HEAD:CHANGELOG.md 2>/dev/null | sed -n 's/^## \[\([0-9][0-9.]*\)\].*/\1/p' | head -n 1)

[ -n "$new_version" ] || abort "no version section found in CHANGELOG.md." "$how"
[ "$new_version" = "$script_version" ] || abort "VERSION in $script is '$script_version', CHANGELOG.md says '$new_version'." "$how"
[ "$new_version" != "$old_version" ] || abort "version $new_version is already in HEAD; every commit needs a new one." "$how"

exit 0
