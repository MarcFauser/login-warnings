#!/bin/sh
# apt-updates-check
#
# Lists the package updates the package lists on disk offer and writes them to
# /run/login-warnings/apt-updates; login-warnings shows that file in every interactive login
# shell, as one section of its display. The file always says when the check ran and how old
# the package lists are: green "none", the updates by name (orange, red when security updates
# or packages in use without a source are among them), orange when the lists are in doubt or
# something can be removed, or an orange "CHECK FAILED" followed by the last successful result
# (kept in /run/login-warnings/.apt-updates.last).
#
# Nothing is downloaded. The check simulates "apt-get dist-upgrade" without locking and
# without writing apt's cache files, so it is safe while apt or dpkg is running. The lists
# are refreshed by apt update: once a day by apt-daily.service, enabled by
# APT::Periodic::Update-Package-Lists in /etc/apt/apt.conf.d/80login-warnings, or by hand.
# The apt hooks in the same file call this script with --stamp start before and with
# --stamp success after every apt update; apt runs the second one as soon as at least one
# repository was fetched. The stamps in /var/lib/login-warnings give the age of the lists.
# --stamp start also leaves a marker that --stamp success removes; a marker that is still
# there means the last apt update reached no repository or did not finish. A single failing
# repository among working ones does not show up here; apt update itself reports it.
#
# The check also names installed packages whose installed version no package source offers
# any more. They get no updates, security updates included, and apt-get dist-upgrade does not
# mention them: what happens when a source file is emptied or removed, or a package came from
# a .deb file. apt-cache policy lists every version with the files it comes from; a version
# that only /var/lib/dpkg/status knows has no source. It tells the ones in use (red: they run
# and get no updates) from the ones left over from an older release (orange), names the
# config files of removed packages that can go and those that must stay, and prints the
# "apt purge" command for exactly what can go, never a pattern like '?obsolete'.
#
# Runs after every boot, dpkg run and apt update (login-warnings). Run it by hand at any
# time, as root.
#
# Usage: apt-updates-check [--quiet] [--trigger boot|dpkg|apt|manual]
#        apt-updates-check --stamp start|success
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

DIR=/run/login-warnings
FILE=$DIR/apt-updates
# Hidden from the login display: the last successful result.
LAST=$DIR/.apt-updates.last
STATE=/var/lib/login-warnings
# Read to tell packages in use from leftovers, and config files that must stay from those that
# can go.
PROC=/proc
INFO=/var/lib/dpkg/info
UCF_REGISTRY=/var/lib/ucf/registry

usage()
{
    echo "Usage: apt-updates-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2
    echo "       apt-updates-check --stamp start|success" >&2
    exit 2
}

quiet=0
trigger=manual
stamp=""
while [ $# -gt 0 ]
do
    case $1 in
        --quiet) quiet=1 ;;
        --trigger) shift; trigger=${1:-} ;;
        --stamp) shift; stamp=${1:-} ;;
        *) usage ;;
    esac
    shift
done

if [ "$(id -u)" -ne 0 ]
then
    echo "Please run as root." >&2
    exit 1
fi

# Writes stdin next to the target and renames it, so nobody reads a half-written file.
publish()
{
    cat > "$1.tmp.$$"
    chmod 0644 "$1.tmp.$$"
    mv -f "$1.tmp.$$" "$1"
}

if [ -n "$stamp" ]
then
    case $stamp in
        start | success) ;;
        *) usage ;;
    esac
    mkdir -p -m 0755 "$STATE"
    # The order of the hooks tells an unfinished apt update, not the times in the stamps: an
    # NTP step during an apt update at boot put the success stamp one second before the start
    # stamp (measured 2026-11-13). The marker holds the start time for the message.
    if [ "$stamp" = start ]
    then
        date '+%s' | publish "$STATE/apt-update-pending"
        date '+%s' | publish "$STATE/apt-update-start"
    else
        date '+%s' | publish "$STATE/apt-update-success"
        rm -f "$STATE/apt-update-pending"
    fi
    exit 0
fi

case $trigger in
    boot) checked_by="at boot" ;;
    dpkg) checked_by="after a package change" ;;
    apt) checked_by="after apt update" ;;
    manual) checked_by="by hand" ;;
    *) usage ;;
esac

# Seconds since the epoch from a stamp file, or nothing if it is missing or not a number.
read_stamp()
{
    value=""
    if [ -f "$STATE/apt-update-$1" ]
    then
        read -r value < "$STATE/apt-update-$1"
    fi
    case $value in
        '' | *[!0-9]*) value="" ;;
    esac
    echo "$value"
}

format_time()
{
    date -d "@$1" '+%Y-%m-%d %H:%M:%S %:z'
}

sim_status=0
sim=$(LC_ALL=C timeout 60 apt-get -s -o Debug::NoLocking=1 -o Dir::Cache::pkgcache= \
    -o Dir::Cache::srcpkgcache= dist-upgrade 2>&1) || sim_status=$?

mkdir -p -m 0755 "$DIR"
checked_at=$(date '+%Y-%m-%d %H:%M:%S %:z')
now=$(date '+%s')

# Red (index 196 of the 256-colour palette) for security updates, orange (index 208) for other
# updates and for problems, green for the all-clear. Palette indexes, not the terminal's own
# red, so the colour does not depend on the terminal's scheme.
red=$(printf '\033[38;5;196m')
orange=$(printf '\033[38;5;208m')
green=$(printf '\033[32m')
reset=$(printf '\033[0m')

# Text wrapped at word boundaries and indented by the given prefix, so that every line stays
# below 80 columns, also in the last successful result that a failed check repeats with four
# more columns of indentation.
wrap()
{
    fold -s -w $((75 - ${#1})) | sed 's/ *$//' | sed "s/^/$1/"
}

# The result is one section of the login display: a title line with the state, the details
# indented by two spaces, lines kept below 80 columns, one colour for the whole section.
footer="  checked $checked_at ($checked_by)
  check again: apt-updates-check"

# Writes the CHECK FAILED section, with the last successful result below it, and exits 1.
# $1 what failed (one line), $2 the command's output, $3 its exit status, $4 the stderr note.
check_failed()
{
    if [ "$3" -eq 124 ]
    then
        errors="    did not finish within 60 seconds"
    else
        errors=$(printf '%s\n' "$2" | grep -E '^(E:|dpkg-query:)' | head -n 3 | wrap '    ')
        if [ -z "$errors" ]
        then
            errors="    exit status $3"
        fi
    fi
    if [ -s "$LAST" ]
    then
        last="  last successful check:
$(sed 's/^/    /' "$LAST")"
    else
        last="  no successful check since boot"
    fi
    printf '%sPackage updates: CHECK FAILED\n  %s\n%s\n%s\n%s%s\n' \
        "$orange" "$1" "$errors" "$footer" "$last" "$reset" | publish "$FILE"
    echo "apt-updates-check: $4" >&2
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 1
}

if [ "$sim_status" -ne 0 ]
then
    check_failed "apt-get could not simulate the upgrade:" "$sim" "$sim_status" \
        "apt-get -s dist-upgrade failed."
fi

# The installed packages, and every version apt knows of them with the files it comes from.
# Without locking and without writing apt's cache files, like the simulation above.
installed_status=0
installed=$(dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' 2>&1) || installed_status=$?
if [ "$installed_status" -ne 0 ]
then
    check_failed "dpkg-query could not list the installed packages:" "$installed" \
        "$installed_status" "dpkg-query -W failed."
fi
policy_status=0
policy=$(printf '%s\n' "$installed" | awk '$1 == "ii" { print $2 }' | LC_ALL=C timeout 60 \
    xargs -r apt-cache -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= policy 2>&1) \
    || policy_status=$?
if [ "$policy_status" -ne 0 ]
then
    check_failed "apt-cache could not list the package versions:" "$policy" "$policy_status" \
        "apt-cache policy failed."
fi

# In the version table of "apt-cache policy" the installed version is the line " *** <version>
# <priority>", other versions start with five spaces, and the files a version comes from follow
# it with eight: "        500 http://deb.debian.org/debian trixie/main amd64 Packages" or
# "        100 /var/lib/dpkg/status". A package whose installed version has only the second one
# has no source.
no_source=$(printf '%s\n' "$policy" | awk '
    function finish() { if (pkg != "" && seen && !sourced) print pkg; pkg = "" }
    /^[^ ]/ { finish(); pkg = $0; sub(/:$/, "", pkg); seen = 0; sourced = 0; current = 0; next }
    /^ \*\*\* / { seen = 1; current = 1; next }
    /^     [^ ]/ { current = 0; next }
    /^        [0-9]/ { if (current && $2 != "/var/lib/dpkg/status") sourced = 1; next }
    END { finish() }' | sort -u)

# The fallback kernel is not reported. apt keeps installed kernels from autoremoval: the
# booted one and the newest ones, APT::NeverAutoRemove::KernelCount in all (2, and never
# fewer), and with each the packages named "<pattern>-<uname>" for every pattern in
# APT::VersionedKernelPackages; the booted uname always. A kernel is an installed package
# "linux-image-<uname>" (or kfreebsd-image-, gnumach-image-) whose uname starts with digits
# and a dot, not ending in -dbg or -dbgsym, and its version is the package version (apt 3.0.3,
# apt-pkg/algorithms.cc lines 1476-1629). Of these, the ones of the newest kernel stay in the
# list: when the newest kernel has no source, the kernel gets no updates. Older kernels that
# apt does not keep stay in the list as well; apt autoremove removes them.
kept_re=""
if [ -n "$no_source" ]
then
    aptconf=$(apt-config dump 2>/dev/null)
    protect=$(printf '%s\n' "$aptconf" | sed -n 's/^APT::Protect-Kernels "\(.*\)";$/\1/p' | tail -n 1)
    keep=$(printf '%s\n' "$aptconf" | sed -n 's/^APT::NeverAutoRemove::KernelCount "\(.*\)";$/\1/p' | tail -n 1)
    patterns=$(printf '%s\n' "$aptconf" | sed -n 's/^APT::VersionedKernelPackages:: "\(.*\)";$/\1/p')
    case $keep in
        '' | *[!0-9]*) keep=2 ;;
    esac
    if [ "$keep" -lt 2 ]
    then
        keep=2
    fi
    # "<version> <uname>" of every installed kernel, from its Installed: line in the policy.
    kernels=$(printf '%s\n' "$policy" | awk '
        /^[^ ]/ { pkg = $0; sub(/:.*/, "", pkg); next }
        /^  Installed: / && pkg ~ /^(linux|kfreebsd|gnumach)-image-[0-9]+\./ && pkg !~ /-dbg(sym)?$/ {
            uname = pkg; sub(/^[a-z]+-image-/, "", uname); print $2, uname }')
    case $protect in
        false | no | off | without | disable | 0) kernels="" ;;
    esac
    if [ -n "$kernels" ] && [ -n "$patterns" ]
    then
        booted=$(uname -r)
        booted_version=$(printf '%s\n' "$kernels" | awk -v u="$booted" '$2 == u { print $1; exit }')
        # The versions, newest first, compared the way dpkg compares them.
        remaining=$(printf '%s\n' "$kernels" | awk '{ print $1 }' | sort -u)
        ordered=""
        while [ -n "$remaining" ]
        do
            newest=""
            for v in $remaining
            do
                if [ -z "$newest" ] || dpkg --compare-versions "$v" gt "$newest"
                then
                    newest=$v
                fi
            done
            ordered="$ordered $newest"
            remaining=$(printf '%s\n' $remaining | grep -vxF -- "$newest")
        done
        set -- $ordered
        newest=$1
        kept=$booted_version
        count_kept=0
        if [ -n "$booted_version" ]
        then
            count_kept=1
        fi
        for v in "$@"
        do
            if [ "$count_kept" -ge "$keep" ]
            then
                break
            fi
            if [ "$v" != "$booted_version" ]
            then
                kept="$kept $v"
                count_kept=$((count_kept + 1))
            fi
        done
        # The packages of every kernel apt keeps, the newest one's included, are in use; that
        # the newest one stays in the list below makes it count as in use there.
        kept_unames=$(printf '%s\n' "$kernels" | awk -v kept=" $kept " 'index(kept, " " $1 " ") { print $2 }')
        kept_unames=$(printf '%s\n%s\n' "$kept_unames" "$booted" | grep . | sort -u \
            | sed 's/[.+]/\\&/g' | paste -sd '|' -)
        kept_re="^($(printf '%s\n' "$patterns" | paste -sd '|' -))-($kept_unames)(:[^:]+)?\$"
        # The unames apt keeps, apart from those of the newest kernel.
        fallback=$(printf '%s\n' "$kernels" | awk -v kept=" $kept " -v newest="$newest" \
            'index(kept, " " $1 " ") && $1 != newest { print $2 }')
        if ! printf '%s\n' "$kernels" | awk -v n="$newest" -v u="$booted" '$1 == n && $2 == u { f = 1 } END { exit !f }'
        then
            fallback="$fallback
$booted"
        fi
        fallback=$(printf '%s\n' "$fallback" | grep . | sed 's/[.+]/\\&/g' | paste -sd '|' -)
        if [ -n "$fallback" ]
        then
            re="^($(printf '%s\n' "$patterns" | paste -sd '|' -))-($fallback)(:[^:]+)?\$"
            no_source=$(printf '%s\n' "$no_source" | grep -Eiv -- "$re")
        fi
    fi
fi
count_no_source=$(printf '%s' "$no_source" | grep -c .)

# The installed packages by name, without the architecture.
installed_names=$(printf '%s\n' "$installed" | awk '$1 ~ /^.i/ { n = $2; sub(/:.*/, "", n); print n }' \
    | LC_ALL=C sort -u)

# Packages without a source that something still uses, and those left over. In use: a running
# process has one of its files mapped (a library or the executable), it ships a systemd unit
# that is enabled or active, it is the kernel that runs or one apt keeps, or an installed
# package depends on it, directly or through another package in use. The rest is left over,
# from an older Debian release or a removed source: nothing runs it and nothing needs it. A
# simulated purge of the leftovers must take nothing else along, or they all count as in use;
# a package that cannot be checked counts as in use. In use is the urgent case: software that
# runs and gets no updates.
in_use=""
leftover=""
if [ "$count_no_source" -gt 0 ]
then
    # The kernel names the files a process maps by their resolved path (/usr/lib on Debian 13,
    # where /lib is a link to usr/lib), and packages from older releases list /lib/..., so the
    # files of a package are resolved before they are compared.
    mapped=$(cat "$PROC"/[0-9]*/maps 2>/dev/null | awk '$6 ~ /^\// { print $6 }' | LC_ALL=C sort -u)
    # "<package> <dependency>" for every installed package, names without architecture.
    deps=$(dpkg-query -W -f='${db:Status-Abbrev}\t${binary:Package}\t${Depends}, ${Pre-Depends}\n' 2>/dev/null \
        | awk -F '\t' '$1 ~ /^.i/ { n = $2; sub(/:.*/, "", n); k = split($3, d, /[,|]/)
            for (i = 1; i <= k; i++) { x = d[i]; sub(/^ +/, "", x); sub(/[ (].*/, "", x); sub(/:.*/, "", x)
                if (x != "") print n, x } }')
    booted=$(uname -r)
    candidates=""
    for p in $no_source
    do
        if ! files=$(dpkg -L "$p" 2>/dev/null)
        then
            in_use="$in_use $p"
            continue
        fi
        case $p in
            *-"$booted" | *-"$booted":*)
                in_use="$in_use $p"
                continue ;;
        esac
        if [ -n "$kept_re" ] && printf '%s\n' "$p" | grep -Eiq -- "$kept_re"
        then
            in_use="$in_use $p"
            continue
        fi
        if [ -n "$mapped" ] && printf '%s\n' "$files" | xargs -r -d '\n' realpath -eq -- 2>/dev/null \
            | LC_ALL=C sort -u | LC_ALL=C comm -12 - /dev/fd/3 3<<EOF | grep -q .
$mapped
EOF
        then
            in_use="$in_use $p"
            continue
        fi
        unit_on=0
        for u in $(printf '%s\n' "$files" | grep -E '^/(usr/)?lib/systemd/system/[^/@]+\.(service|socket|timer)$' \
            | sed 's|.*/||' | sort -u)
        do
            if [ "$(systemctl is-enabled "$u" 2>/dev/null)" = enabled ] \
                || [ "$(systemctl is-active "$u" 2>/dev/null)" = active ]
            then
                unit_on=1
                break
            fi
        done
        if [ "$unit_on" -eq 1 ]
        then
            in_use="$in_use $p"
            continue
        fi
        candidates="$candidates $p"
    done
    # A candidate is in use when a package outside the candidates depends on it (a purge would
    # take that package along), or when it depends on a package in use itself (it belongs to
    # that software, like mariadb-server-compat to mariadb-server). Until nothing changes.
    changed=1
    while [ "$changed" -eq 1 ] && [ -n "$candidates" ]
    do
        changed=0
        names=" $(printf '%s\n' $candidates | sed 's/:.*//' | tr '\n' ' ')"
        used=" $(printf '%s\n' $in_use | sed 's/:.*//' | tr '\n' ' ')"
        remaining=""
        for p in $candidates
        do
            if printf '%s\n' "$deps" | awk -v n="${p%%:*}" -v cand="$names" -v used="$used" \
                '($2 == n && !index(cand, " " $1 " ")) || ($1 == n && index(used, " " $2 " ")) { f = 1 }
                 END { exit !f }'
            then
                in_use="$in_use $p"
                changed=1
            else
                remaining="$remaining $p"
            fi
        done
        candidates=$remaining
    done
    if [ -n "$candidates" ]
    then
        purge_sim_status=0
        purge_sim=$(LC_ALL=C timeout 60 apt-get -s -o Debug::NoLocking=1 -o Dir::Cache::pkgcache= \
            -o Dir::Cache::srcpkgcache= purge $candidates 2>&1) || purge_sim_status=$?
        names=" $(printf '%s\n' $candidates | sed 's/:.*//' | tr '\n' ' ')"
        beyond=$(printf '%s\n' "$purge_sim" | awk -v cand="$names" \
            '/^(Purg|Remv) / { n = $2; sub(/:.*/, "", n); if (!index(cand, " " n " ")) print n }')
        if [ "$purge_sim_status" -ne 0 ] || [ -n "$beyond" ]
        then
            in_use="$in_use $candidates"
        else
            leftover=$candidates
        fi
    fi
    in_use=$(printf '%s\n' $in_use | LC_ALL=C sort -u)
    leftover=$(printf '%s\n' $leftover | LC_ALL=C sort -u)
fi
count_in_use=$(printf '%s' "$in_use" | grep -c .)
count_leftover=$(printf '%s' "$leftover" | grep -c .)

# The installed packages that own a path, apart from the given package; dpkg -S names them as
# "<package>[, <package>...]: <path>", and diversions as "diversion by ...".
owners()
{
    dpkg -S "$1" 2>/dev/null | grep -v '^diversion ' | sed 's|: /.*$||' | tr ',' '\n' \
        | sed 's/^ *//; s/:.*//' | grep -vxF -- "$2" | grep -xF -f /dev/fd/3 3<<EOF
$installed_names
EOF
}

# Removed packages whose config files are left (dpkg state rc). Purging one runs its postrm with
# "purge", and three things in it break what an installed package needs, all seen on real
# servers: a unit switched off with deb-systemd-helper that an installed package now ships
# (pve-kernel-helper, ifupdown next to ifupdown2), a file deleted that an installed package
# owns or has registered with ucf (grub-pc's /etc/default/grub on a host booting with
# grub-efi-amd64), and a conffile in its own file list that another installed package owns.
# Such a package must stay; the others can go. One that cannot be checked stays.
rc_go=""
rc_keep=""
# The second letter of the state is what is installed: "c" for config files only, whether the
# first, the wanted action, says remove ("rc") or install ("ic", seen for ifupdown).
rc=$(printf '%s\n' "$installed" | awk '$1 ~ /^.c/ { print $2 }' | LC_ALL=C sort -u)
arch=$(dpkg --print-architecture 2>/dev/null)
for p in $rc
do
    name=${p%%:*}
    postrm=""
    list=""
    # dpkg keeps the scripts and the file list of a Multi-Arch: same package as <name>:<arch>.
    for f in "$INFO/$p" "$INFO/$name" "$INFO/$name:$arch"
    do
        [ -z "$postrm" ] && [ -f "$f.postrm" ] && postrm=$f.postrm
        [ -z "$list" ] && [ -f "$f.list" ] && list=$f.list
    done
    reason=""
    if [ -n "$postrm" ]
    then
        for u in $(grep -oE "deb-systemd-helper +(purge|disable|mask) +'?[A-Za-z0-9@_.:-]+\.(service|socket|timer|path|mount|target)" \
            "$postrm" | sed "s/.*[ ']//" | sort -u)
        do
            owner=$( { owners "/usr/lib/systemd/system/$u" "$name"; owners "/lib/systemd/system/$u" "$name"; } | head -n 1)
            if [ -n "$owner" ]
            then
                reason="its purge would switch off $u of $owner"
                break
            fi
        done
    fi
    if [ -z "$reason" ]
    then
        if conffiles=$(dpkg-query -W -f='${Conffiles}\n' "$p" 2>/dev/null)
        then
            for f in $(printf '%s\n' "$conffiles" | awk 'NF { print $1 }')
            do
                if [ -n "$list" ] && grep -qxF -- "$f" "$list"
                then
                    owner=$(owners "$f" "$name" | head -n 1)
                    if [ -n "$owner" ]
                    then
                        reason="its purge would delete $f of $owner"
                        break
                    fi
                fi
            done
        else
            reason="it could not be checked"
        fi
    fi
    if [ -z "$reason" ] && [ -n "$postrm" ]
    then
        for f in $(grep -oE "(rm( +-[A-Za-z]+)*|ucf +--purge|ucfr +--purge +[^ ]+) +[\"']?/[^ ;|&\$*?\"'\`]+" "$postrm" \
            | awk '{ print $NF }' | sed "s/^[\"']//" | sort -u)
        do
            owner=$(owners "$f" "$name" | head -n 1)
            if [ -z "$owner" ] && [ -f "$UCF_REGISTRY" ]
            then
                owner=$(awk -v f="$f" -v self="$name" '$2 == f && $1 != self { print $1 }' "$UCF_REGISTRY" \
                    | grep -xF -f /dev/fd/3 3<<EOF | head -n 1
$installed_names
EOF
)
            fi
            if [ -n "$owner" ]
            then
                reason="its purge would delete $f of $owner"
                break
            fi
        done
    fi
    if [ -n "$reason" ]
    then
        rc_keep="$rc_keep
$p: $reason"
    else
        rc_go="$rc_go $p"
    fi
done
rc_go=$(printf '%s\n' $rc_go | grep .)
rc_keep=$(printf '%s\n' "$rc_keep" | grep .)
count_rc_go=$(printf '%s' "$rc_go" | grep -c .)
count_rc_keep=$(printf '%s' "$rc_keep" | grep -c .)

# "Inst <package> [<installed>] (<candidate> <archives> [<arch>])" is an upgrade; a line
# without "[<installed>]" is a package that gets newly installed. A candidate from a security
# archive names it in <archives>, e.g. "Debian-Security:13/stable-security".
security=$(printf '%s\n' "$sim" | awk '/^Inst [^ ]+ \[/ && /\(.*-[Ss]ecurity/ { print $2 }' | sort -u)
other=$(printf '%s\n' "$sim" | awk '/^Inst [^ ]+ \[/ && !/\(.*-[Ss]ecurity/ { print $2 }' | sort -u)
count_security=$(printf '%s' "$security" | grep -c .)
count_other=$(printf '%s' "$other" | grep -c .)
count=$((count_security + count_other))

success=$(read_stamp success)
if [ -n "$success" ]
then
    age=$((now - success))
    if [ "$age" -lt 0 ]
    then
        age=0
    fi
    if [ "$age" -lt 3600 ]
    then
        ago="$((age / 60)) min ago"
    elif [ "$age" -lt 172800 ]
    then
        ago="$((age / 3600)) h ago"
    else
        ago="$((age / 86400)) days ago"
    fi
    lists="  lists from $(format_time "$success") ($ago)"
else
    lists="  lists of unknown age"
fi

# An apt update whose marker is still there has reached no repository or is still running.
# Lists older than two days mean that the daily refresh has not run at least once:
# apt.systemd.daily updates once per calendar day, and apt-daily.timer (6:00 and 18:00, up to
# 12 h random delay) runs at least once between 6:00 and 18:00 every day, so a working
# refresh leaves at most about 42 hours between two updates.
problem=""
if [ -e "$STATE/apt-update-pending" ]
then
    pending=$(read_stamp pending)
    if [ -n "$pending" ]
    then
        problem="the apt update started $(format_time "$pending") reached no repository or did not finish; run apt update to see why"
    else
        problem="the last apt update reached no repository or did not finish; run apt update to see why"
    fi
elif [ -z "$success" ]
then
    problem="no apt update recorded yet; run: apt update"
elif [ "$age" -ge 172800 ]
then
    problem="the daily apt update has not run since; check: systemctl status apt-daily.timer"
fi

# Red for security updates and for packages in use that no source offers (they never get a
# security update, so they count like one), orange for other updates, for leftovers and config
# files that can go, and for a problem with the lists; green when there is nothing to do.
# Config files that must stay are listed and change nothing.
if [ "$count_security" -gt 0 ] || [ "$count_in_use" -gt 0 ]
then
    colour=$red
elif [ "$count" -gt 0 ] || [ -n "$problem" ] || [ "$count_leftover" -gt 0 ] || [ "$count_rc_go" -gt 0 ]
then
    colour=$orange
else
    colour=$green
fi

# "<n> package(s)", singular for one.
packages()
{
    if [ "$1" -eq 1 ]
    then
        echo "1 package"
    else
        echo "$1 packages"
    fi
}

# The words on stdin as an "apt purge" command, split with backslashes so that every line
# stays below 80 columns and the lines can be copied in one piece.
purge_command()
{
    tr ' ' '\n' | grep . | awk -v ind="$1" '
        BEGIN { line = ind "apt purge" }
        { if (length(line) + 1 + length($0) > 73) { print line " \\"; line = ind "  " $0 }
          else line = line " " $0 }
        END { print line }'
}

{
    printf '%s' "$colour"
    if [ "$count" -eq 0 ]
    then
        echo "Package updates: none"
    else
        echo "Package updates: $count ($count_security security)"
        if [ "$count_security" -gt 0 ]
        then
            printf 'security: %s\n' "$(printf '%s\n' "$security" | tr '\n' ' ')" | wrap '  '
            if [ "$count_other" -gt 0 ]
            then
                printf 'other: %s\n' "$(printf '%s\n' "$other" | tr '\n' ' ')" | wrap '  '
            fi
        else
            printf '%s\n' "$(printf '%s\n' "$other" | tr '\n' ' ')" | wrap '  '
        fi
        echo "  show: apt list --upgradable"
    fi
    echo "$lists"
    if [ -n "$problem" ]
    then
        printf '%s\n' "$problem" | wrap '  '
    fi
    if [ "$count_in_use" -gt 0 ]
    then
        if [ "$count_in_use" -eq 1 ]
        then
            what="1 package in use, so it gets"
        else
            what="$count_in_use packages in use, so they get"
        fi
        printf '%s\n' "no package source offers the installed version of $what no updates:" \
            | wrap '  '
        printf '%s\n' "$(printf '%s\n' "$in_use" | tr '\n' ' ')" | wrap '    '
        echo "  show: apt-cache policy $(printf '%s\n' "$in_use" | head -n 1)"
    fi
    if [ "$count_leftover" -gt 0 ]
    then
        printf '%s\n' "left over, without a source and not in use now: $(packages "$count_leftover")" | wrap '  '
        printf '%s\n' "$(printf '%s\n' "$leftover" | tr '\n' ' ')" | wrap '    '
    fi
    if [ "$count_rc_go" -gt 0 ]
    then
        printf '%s\n' "config files of removed packages that can go: $(packages "$count_rc_go")" | wrap '  '
        printf '%s\n' "$(printf '%s\n' "$rc_go" | tr '\n' ' ')" | wrap '    '
    fi
    if [ "$count_rc_keep" -gt 0 ]
    then
        printf '%s\n' "config files of removed packages that must stay: $(packages "$count_rc_keep")" | wrap '  '
        printf '%s\n' "$rc_keep" | while IFS= read -r line
        do
            printf '%s\n' "$line" | wrap '      ' | sed '1s/^      /    /'
        done
    fi
    if [ "$count_leftover" -gt 0 ] || [ "$count_rc_go" -gt 0 ]
    then
        echo "  remove what can go (apt lists it and asks first):"
        printf '%s\n' $leftover $rc_go | purge_command '    '
    fi
    printf '%s%s\n' "$footer" "$reset"
} | publish "$FILE"
publish "$LAST" < "$FILE"

if [ "$quiet" -eq 0 ]
then
    cat "$FILE"
fi
