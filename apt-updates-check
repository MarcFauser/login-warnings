#!/bin/sh
# apt-updates-check
#
# Lists the package updates the package lists on disk offer and writes them to
# /run/login-warnings/apt-updates; login-warnings shows that file in every interactive login
# shell, as one section of its display. The file always says when the check ran and how old
# the package lists are: green "none", the updates by name (orange, red when security updates
# or packages without a source are among them), orange when the lists are in doubt, or an
# orange "CHECK FAILED" followed by the last successful result (kept in
# /run/login-warnings/.apt-updates.last).
#
# Nothing is downloaded. The check simulates "apt-get dist-upgrade" without locking and
# without writing apt's cache files, so it is safe while apt or dpkg is running. The lists
# are refreshed by apt update: once a day by apt-daily.service, enabled by
# APT::Periodic::Update-Package-Lists in /etc/apt/apt.conf.d/80login-warnings, or by hand.
# The apt hooks in the same file call this script with --stamp start before and with
# --stamp success after every apt update; apt runs the second one as soon as at least one
# repository was fetched. The stamps in /var/lib/login-warnings give the age of the lists.
# --stamp start also leaves a marker that --stamp success removes; a marker that is still
# there means the last apt update reached no repository or did not finish. A single failing
# repository among working ones does not show up here; apt update itself reports it.
#
# The check also names installed packages whose installed version no package source offers
# any more. They get no updates, security updates included, and apt-get dist-upgrade does not
# mention them: what happens when a source file is emptied or removed, or a package came from
# a .deb file. apt-cache policy lists every version with the files it comes from; a version
# that only /var/lib/dpkg/status knows has no source.
#
# Runs after every boot, dpkg run and apt update (login-warnings). Run it by hand at any
# time, as root.
#
# Usage: apt-updates-check [--quiet] [--trigger boot|dpkg|apt|manual]
#        apt-updates-check --stamp start|success
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

DIR=/run/login-warnings
FILE=$DIR/apt-updates
# Hidden from the login display: the last successful result.
LAST=$DIR/.apt-updates.last
STATE=/var/lib/login-warnings

usage()
{
    echo "Usage: apt-updates-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2
    echo "       apt-updates-check --stamp start|success" >&2
    exit 2
}

quiet=0
trigger=manual
stamp=""
while [ $# -gt 0 ]
do
    case $1 in
        --quiet) quiet=1 ;;
        --trigger) shift; trigger=${1:-} ;;
        --stamp) shift; stamp=${1:-} ;;
        *) usage ;;
    esac
    shift
done

if [ "$(id -u)" -ne 0 ]
then
    echo "Please run as root." >&2
    exit 1
fi

# Writes stdin next to the target and renames it, so nobody reads a half-written file.
publish()
{
    cat > "$1.tmp.$$"
    chmod 0644 "$1.tmp.$$"
    mv -f "$1.tmp.$$" "$1"
}

if [ -n "$stamp" ]
then
    case $stamp in
        start | success) ;;
        *) usage ;;
    esac
    mkdir -p -m 0755 "$STATE"
    # The order of the hooks tells an unfinished apt update, not the times in the stamps: an
    # NTP step during an apt update at boot put the success stamp one second before the start
    # stamp (measured 2026-11-13). The marker holds the start time for the message.
    if [ "$stamp" = start ]
    then
        date '+%s' | publish "$STATE/apt-update-pending"
        date '+%s' | publish "$STATE/apt-update-start"
    else
        date '+%s' | publish "$STATE/apt-update-success"
        rm -f "$STATE/apt-update-pending"
    fi
    exit 0
fi

case $trigger in
    boot) checked_by="at boot" ;;
    dpkg) checked_by="after a package change" ;;
    apt) checked_by="after apt update" ;;
    manual) checked_by="by hand" ;;
    *) usage ;;
esac

# Seconds since the epoch from a stamp file, or nothing if it is missing or not a number.
read_stamp()
{
    value=""
    if [ -f "$STATE/apt-update-$1" ]
    then
        read -r value < "$STATE/apt-update-$1"
    fi
    case $value in
        '' | *[!0-9]*) value="" ;;
    esac
    echo "$value"
}

format_time()
{
    date -d "@$1" '+%Y-%m-%d %H:%M:%S %:z'
}

sim_status=0
sim=$(LC_ALL=C timeout 60 apt-get -s -o Debug::NoLocking=1 -o Dir::Cache::pkgcache= \
    -o Dir::Cache::srcpkgcache= dist-upgrade 2>&1) || sim_status=$?

mkdir -p -m 0755 "$DIR"
checked_at=$(date '+%Y-%m-%d %H:%M:%S %:z')
now=$(date '+%s')

# Red (index 196 of the 256-colour palette) for security updates, orange (index 208) for other
# updates and for problems, green for the all-clear. Palette indexes, not the terminal's own
# red, so the colour does not depend on the terminal's scheme.
red=$(printf '\033[38;5;196m')
orange=$(printf '\033[38;5;208m')
green=$(printf '\033[32m')
reset=$(printf '\033[0m')

# Text wrapped at word boundaries and indented by the given prefix, so that every line stays
# below 80 columns, also in the last successful result that a failed check repeats with four
# more columns of indentation.
wrap()
{
    fold -s -w $((75 - ${#1})) | sed 's/ *$//' | sed "s/^/$1/"
}

# The result is one section of the login display: a title line with the state, the details
# indented by two spaces, lines kept below 80 columns, one colour for the whole section.
footer="  checked $checked_at ($checked_by)
  check again: apt-updates-check"

# Writes the CHECK FAILED section, with the last successful result below it, and exits 1.
# $1 what failed (one line), $2 the command's output, $3 its exit status, $4 the stderr note.
check_failed()
{
    if [ "$3" -eq 124 ]
    then
        errors="    did not finish within 60 seconds"
    else
        errors=$(printf '%s\n' "$2" | grep -E '^(E:|dpkg-query:)' | head -n 3 | wrap '    ')
        if [ -z "$errors" ]
        then
            errors="    exit status $3"
        fi
    fi
    if [ -s "$LAST" ]
    then
        last="  last successful check:
$(sed 's/^/    /' "$LAST")"
    else
        last="  no successful check since boot"
    fi
    printf '%sPackage updates: CHECK FAILED\n  %s\n%s\n%s\n%s%s\n' \
        "$orange" "$1" "$errors" "$footer" "$last" "$reset" | publish "$FILE"
    echo "apt-updates-check: $4" >&2
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 1
}

if [ "$sim_status" -ne 0 ]
then
    check_failed "apt-get could not simulate the upgrade:" "$sim" "$sim_status" \
        "apt-get -s dist-upgrade failed."
fi

# The installed packages, and every version apt knows of them with the files it comes from.
# Without locking and without writing apt's cache files, like the simulation above.
installed_status=0
installed=$(dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' 2>&1) || installed_status=$?
if [ "$installed_status" -ne 0 ]
then
    check_failed "dpkg-query could not list the installed packages:" "$installed" \
        "$installed_status" "dpkg-query -W failed."
fi
policy_status=0
policy=$(printf '%s\n' "$installed" | awk '$1 == "ii" { print $2 }' | LC_ALL=C timeout 60 \
    xargs -r apt-cache -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= policy 2>&1) \
    || policy_status=$?
if [ "$policy_status" -ne 0 ]
then
    check_failed "apt-cache could not list the package versions:" "$policy" "$policy_status" \
        "apt-cache policy failed."
fi

# In the version table of "apt-cache policy" the installed version is the line " *** <version>
# <priority>", other versions start with five spaces, and the files a version comes from follow
# it with eight: "        500 http://deb.debian.org/debian trixie/main amd64 Packages" or
# "        100 /var/lib/dpkg/status". A package whose installed version has only the second one
# has no source.
no_source=$(printf '%s\n' "$policy" | awk '
    function finish() { if (pkg != "" && seen && !sourced) print pkg; pkg = "" }
    /^[^ ]/ { finish(); pkg = $0; sub(/:$/, "", pkg); seen = 0; sourced = 0; current = 0; next }
    /^ \*\*\* / { seen = 1; current = 1; next }
    /^     [^ ]/ { current = 0; next }
    /^        [0-9]/ { if (current && $2 != "/var/lib/dpkg/status") sourced = 1; next }
    END { finish() }' | sort -u)

# The fallback kernel is not reported. apt keeps installed kernels from autoremoval: the
# booted one and the newest ones, APT::NeverAutoRemove::KernelCount in all (2, and never
# fewer), and with each the packages named "<pattern>-<uname>" for every pattern in
# APT::VersionedKernelPackages; the booted uname always. A kernel is an installed package
# "linux-image-<uname>" (or kfreebsd-image-, gnumach-image-) whose uname starts with digits
# and a dot, not ending in -dbg or -dbgsym, and its version is the package version (apt 3.0.3,
# apt-pkg/algorithms.cc lines 1476-1629). Of these, the ones of the newest kernel stay in the
# list: when the newest kernel has no source, the kernel gets no updates. Older kernels that
# apt does not keep stay in the list as well; apt autoremove removes them.
if [ -n "$no_source" ]
then
    aptconf=$(apt-config dump 2>/dev/null)
    protect=$(printf '%s\n' "$aptconf" | sed -n 's/^APT::Protect-Kernels "\(.*\)";$/\1/p' | tail -n 1)
    keep=$(printf '%s\n' "$aptconf" | sed -n 's/^APT::NeverAutoRemove::KernelCount "\(.*\)";$/\1/p' | tail -n 1)
    patterns=$(printf '%s\n' "$aptconf" | sed -n 's/^APT::VersionedKernelPackages:: "\(.*\)";$/\1/p')
    case $keep in
        '' | *[!0-9]*) keep=2 ;;
    esac
    if [ "$keep" -lt 2 ]
    then
        keep=2
    fi
    # "<version> <uname>" of every installed kernel, from its Installed: line in the policy.
    kernels=$(printf '%s\n' "$policy" | awk '
        /^[^ ]/ { pkg = $0; sub(/:.*/, "", pkg); next }
        /^  Installed: / && pkg ~ /^(linux|kfreebsd|gnumach)-image-[0-9]+\./ && pkg !~ /-dbg(sym)?$/ {
            uname = pkg; sub(/^[a-z]+-image-/, "", uname); print $2, uname }')
    case $protect in
        false | no | off | without | disable | 0) kernels="" ;;
    esac
    if [ -n "$kernels" ] && [ -n "$patterns" ]
    then
        booted=$(uname -r)
        booted_version=$(printf '%s\n' "$kernels" | awk -v u="$booted" '$2 == u { print $1; exit }')
        # The versions, newest first, compared the way dpkg compares them.
        remaining=$(printf '%s\n' "$kernels" | awk '{ print $1 }' | sort -u)
        ordered=""
        while [ -n "$remaining" ]
        do
            newest=""
            for v in $remaining
            do
                if [ -z "$newest" ] || dpkg --compare-versions "$v" gt "$newest"
                then
                    newest=$v
                fi
            done
            ordered="$ordered $newest"
            remaining=$(printf '%s\n' $remaining | grep -vxF -- "$newest")
        done
        set -- $ordered
        newest=$1
        kept=$booted_version
        count_kept=0
        if [ -n "$booted_version" ]
        then
            count_kept=1
        fi
        for v in "$@"
        do
            if [ "$count_kept" -ge "$keep" ]
            then
                break
            fi
            if [ "$v" != "$booted_version" ]
            then
                kept="$kept $v"
                count_kept=$((count_kept + 1))
            fi
        done
        # The unames apt keeps, apart from those of the newest kernel.
        fallback=$(printf '%s\n' "$kernels" | awk -v kept=" $kept " -v newest="$newest" \
            'index(kept, " " $1 " ") && $1 != newest { print $2 }')
        if ! printf '%s\n' "$kernels" | awk -v n="$newest" -v u="$booted" '$1 == n && $2 == u { f = 1 } END { exit !f }'
        then
            fallback="$fallback
$booted"
        fi
        fallback=$(printf '%s\n' "$fallback" | grep . | sed 's/[.+]/\\&/g' | paste -sd '|' -)
        if [ -n "$fallback" ]
        then
            re="^($(printf '%s\n' "$patterns" | paste -sd '|' -))-($fallback)(:[^:]+)?\$"
            no_source=$(printf '%s\n' "$no_source" | grep -Eiv -- "$re")
        fi
    fi
fi
count_no_source=$(printf '%s' "$no_source" | grep -c .)

# "Inst <package> [<installed>] (<candidate> <archives> [<arch>])" is an upgrade; a line
# without "[<installed>]" is a package that gets newly installed. A candidate from a security
# archive names it in <archives>, e.g. "Debian-Security:13/stable-security".
security=$(printf '%s\n' "$sim" | awk '/^Inst [^ ]+ \[/ && /\(.*-[Ss]ecurity/ { print $2 }' | sort -u)
other=$(printf '%s\n' "$sim" | awk '/^Inst [^ ]+ \[/ && !/\(.*-[Ss]ecurity/ { print $2 }' | sort -u)
count_security=$(printf '%s' "$security" | grep -c .)
count_other=$(printf '%s' "$other" | grep -c .)
count=$((count_security + count_other))

success=$(read_stamp success)
if [ -n "$success" ]
then
    age=$((now - success))
    if [ "$age" -lt 0 ]
    then
        age=0
    fi
    if [ "$age" -lt 3600 ]
    then
        ago="$((age / 60)) min ago"
    elif [ "$age" -lt 172800 ]
    then
        ago="$((age / 3600)) h ago"
    else
        ago="$((age / 86400)) days ago"
    fi
    lists="  lists from $(format_time "$success") ($ago)"
else
    lists="  lists of unknown age"
fi

# An apt update whose marker is still there has reached no repository or is still running.
# Lists older than two days mean that the daily refresh has not run at least once:
# apt.systemd.daily updates once per calendar day, and apt-daily.timer (6:00 and 18:00, up to
# 12 h random delay) runs at least once between 6:00 and 18:00 every day, so a working
# refresh leaves at most about 42 hours between two updates.
problem=""
if [ -e "$STATE/apt-update-pending" ]
then
    pending=$(read_stamp pending)
    if [ -n "$pending" ]
    then
        problem="the apt update started $(format_time "$pending") reached no repository or did not finish; run apt update to see why"
    else
        problem="the last apt update reached no repository or did not finish; run apt update to see why"
    fi
elif [ -z "$success" ]
then
    problem="no apt update recorded yet; run: apt update"
elif [ "$age" -ge 172800 ]
then
    problem="the daily apt update has not run since; check: systemctl status apt-daily.timer"
fi

# Red for security updates and for packages without a source (they never get a security
# update, so they count like one), orange for other updates and for a problem with the lists,
# green when there is nothing to do.
if [ "$count_security" -gt 0 ] || [ "$count_no_source" -gt 0 ]
then
    colour=$red
elif [ "$count" -gt 0 ] || [ -n "$problem" ]
then
    colour=$orange
else
    colour=$green
fi

{
    printf '%s' "$colour"
    if [ "$count" -eq 0 ]
    then
        echo "Package updates: none"
    else
        echo "Package updates: $count ($count_security security)"
        if [ "$count_security" -gt 0 ]
        then
            printf 'security: %s\n' "$(printf '%s\n' "$security" | tr '\n' ' ')" | wrap '  '
            if [ "$count_other" -gt 0 ]
            then
                printf 'other: %s\n' "$(printf '%s\n' "$other" | tr '\n' ' ')" | wrap '  '
            fi
        else
            printf '%s\n' "$(printf '%s\n' "$other" | tr '\n' ' ')" | wrap '  '
        fi
        echo "  show: apt list --upgradable"
    fi
    echo "$lists"
    if [ -n "$problem" ]
    then
        printf '%s\n' "$problem" | wrap '  '
    fi
    if [ "$count_no_source" -gt 0 ]
    then
        if [ "$count_no_source" -eq 1 ]
        then
            what="1 installed package, so it gets"
        else
            what="$count_no_source installed packages, so they get"
        fi
        printf '%s\n' "no package source offers the installed version of $what no updates:" \
            | wrap '  '
        printf '%s\n' "$(printf '%s\n' "$no_source" | tr '\n' ' ')" | wrap '    '
        echo "  show: apt-cache policy $(printf '%s\n' "$no_source" | head -n 1)"
    fi
    printf '%s%s\n' "$footer" "$reset"
} | publish "$FILE"
publish "$LAST" < "$FILE"

if [ "$quiet" -eq 0 ]
then
    cat "$FILE"
fi
