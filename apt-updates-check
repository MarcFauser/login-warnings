#!/bin/sh
# apt-updates-check
#
# Lists the package updates the package lists on disk offer and writes them to
# /run/login-warnings/apt-updates; login-warnings shows that file in every interactive login
# shell, as one section of its display. The file always says when the check ran and how old
# the package lists are: green "none", the updates by name (orange when security updates are
# among them or the lists are in doubt), or an orange "CHECK FAILED" followed by the last
# successful result (kept in /run/login-warnings/.apt-updates.last).
#
# Nothing is downloaded. The check simulates "apt-get dist-upgrade" without locking and
# without writing apt's cache files, so it is safe while apt or dpkg is running. The lists
# are refreshed by apt update: once a day by apt-daily.service, enabled by
# APT::Periodic::Update-Package-Lists in /etc/apt/apt.conf.d/80login-warnings, or by hand.
# The apt hooks in the same file call this script with --stamp start before and with
# --stamp success after every apt update; apt runs the second one as soon as at least one
# repository was fetched. The stamps in /var/lib/login-warnings give the age of the lists and
# show when the last apt update reached no repository or did not finish. A single failing
# repository among working ones does not show up here; apt update itself reports it.
#
# Runs after every boot, dpkg run and apt update (login-warnings). Run it by hand at any
# time, as root.
#
# Usage: apt-updates-check [--quiet] [--trigger boot|dpkg|apt|manual]
#        apt-updates-check --stamp start|success
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

DIR=/run/login-warnings
FILE=$DIR/apt-updates
# Hidden from the login display: the last successful result.
LAST=$DIR/.apt-updates.last
STATE=/var/lib/login-warnings

usage()
{
    echo "Usage: apt-updates-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2
    echo "       apt-updates-check --stamp start|success" >&2
    exit 2
}

quiet=0
trigger=manual
stamp=""
while [ $# -gt 0 ]
do
    case $1 in
        --quiet) quiet=1 ;;
        --trigger) shift; trigger=${1:-} ;;
        --stamp) shift; stamp=${1:-} ;;
        *) usage ;;
    esac
    shift
done

if [ "$(id -u)" -ne 0 ]
then
    echo "Please run as root." >&2
    exit 1
fi

# Writes stdin next to the target and renames it, so nobody reads a half-written file.
publish()
{
    cat > "$1.tmp.$$"
    chmod 0644 "$1.tmp.$$"
    mv -f "$1.tmp.$$" "$1"
}

if [ -n "$stamp" ]
then
    case $stamp in
        start | success) ;;
        *) usage ;;
    esac
    mkdir -p -m 0755 "$STATE"
    date '+%s' | publish "$STATE/apt-update-$stamp"
    exit 0
fi

case $trigger in
    boot) checked_by="at boot" ;;
    dpkg) checked_by="after a package change" ;;
    apt) checked_by="after apt update" ;;
    manual) checked_by="by hand" ;;
    *) usage ;;
esac

# Seconds since the epoch from a stamp file, or nothing if it is missing or not a number.
read_stamp()
{
    value=""
    if [ -f "$STATE/apt-update-$1" ]
    then
        read -r value < "$STATE/apt-update-$1"
    fi
    case $value in
        '' | *[!0-9]*) value="" ;;
    esac
    echo "$value"
}

format_time()
{
    date -d "@$1" '+%Y-%m-%d %H:%M:%S %:z'
}

sim_status=0
sim=$(LC_ALL=C timeout 60 apt-get -s -o Debug::NoLocking=1 -o Dir::Cache::pkgcache= \
    -o Dir::Cache::srcpkgcache= dist-upgrade 2>&1) || sim_status=$?

mkdir -p -m 0755 "$DIR"
checked_at=$(date '+%Y-%m-%d %H:%M:%S %:z')
now=$(date '+%s')

# Orange (index 208 of the 256-colour palette) for problems, green for the all-clear.
orange=$(printf '\033[38;5;208m')
green=$(printf '\033[32m')
reset=$(printf '\033[0m')

# Text wrapped below 80 columns and indented by the given prefix.
wrap()
{
    fold -s -w 76 | sed 's/ *$//' | sed "s/^/$1/"
}

# The result is one section of the login display: a title line with the state, the details
# indented by two spaces, lines kept below 80 columns, one colour for the whole section.
footer="  checked $checked_at ($checked_by)
  check again: apt-updates-check"

if [ "$sim_status" -ne 0 ]
then
    if [ "$sim_status" -eq 124 ]
    then
        errors="    did not finish within 60 seconds"
    else
        errors=$(printf '%s\n' "$sim" | grep '^E:' | head -n 3 | wrap '    ')
        if [ -z "$errors" ]
        then
            errors="    exit status $sim_status"
        fi
    fi
    if [ -s "$LAST" ]
    then
        last="  last successful check:
$(sed 's/^/    /' "$LAST")"
    else
        last="  no successful check since boot"
    fi
    printf '%sPackage updates: CHECK FAILED\n  apt-get could not simulate the upgrade:\n%s\n%s\n%s%s\n' \
        "$orange" "$errors" "$footer" "$last" "$reset" | publish "$FILE"
    echo "apt-updates-check: apt-get -s dist-upgrade failed." >&2
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 1
fi

# "Inst <package> [<installed>] (<candidate> <archives> [<arch>])" is an upgrade; a line
# without "[<installed>]" is a package that gets newly installed. A candidate from a security
# archive names it in <archives>, e.g. "Debian-Security:13/stable-security".
security=$(printf '%s\n' "$sim" | awk '/^Inst [^ ]+ \[/ && /\(.*-[Ss]ecurity/ { print $2 }' | sort -u)
other=$(printf '%s\n' "$sim" | awk '/^Inst [^ ]+ \[/ && !/\(.*-[Ss]ecurity/ { print $2 }' | sort -u)
count_security=$(printf '%s' "$security" | grep -c .)
count_other=$(printf '%s' "$other" | grep -c .)
count=$((count_security + count_other))

start=$(read_stamp start)
success=$(read_stamp success)
if [ -n "$success" ]
then
    age=$((now - success))
    if [ "$age" -lt 0 ]
    then
        age=0
    fi
    if [ "$age" -lt 3600 ]
    then
        ago="$((age / 60)) min ago"
    elif [ "$age" -lt 172800 ]
    then
        ago="$((age / 3600)) h ago"
    else
        ago="$((age / 86400)) days ago"
    fi
    lists="  lists from $(format_time "$success") ($ago)"
else
    lists="  lists of unknown age"
fi

# An apt update that started after the last fetched repository has failed or is still running.
# Lists older than two days mean that the daily refresh has not run at least once:
# apt.systemd.daily updates once per calendar day, and apt-daily.timer (6:00 and 18:00, up to
# 12 h random delay) runs at least once between 6:00 and 18:00 every day, so a working
# refresh leaves at most about 42 hours between two updates.
problem=""
if [ -n "$start" ] && { [ -z "$success" ] || [ "$success" -lt "$start" ]; }
then
    problem="the apt update started $(format_time "$start") reached no repository or did not finish; run apt update to see why"
elif [ -z "$success" ]
then
    problem="no apt update recorded since login-warnings 3 was installed; run: apt update"
elif [ "$age" -ge 172800 ]
then
    problem="the daily apt update has not run since; check: systemctl status apt-daily.timer"
fi

# Pending updates alone are no reason for alarm: plain, unless security updates or a problem
# with the lists make it orange; green when there is nothing to do.
if [ "$count_security" -gt 0 ] || [ -n "$problem" ]
then
    colour=$orange
elif [ "$count" -eq 0 ]
then
    colour=$green
else
    colour=""
fi

{
    printf '%s' "$colour"
    if [ "$count" -eq 0 ]
    then
        echo "Package updates: none"
    else
        echo "Package updates: $count ($count_security security)"
        if [ "$count_security" -gt 0 ]
        then
            printf 'security: %s\n' "$(printf '%s\n' "$security" | tr '\n' ' ')" | wrap '  '
            if [ "$count_other" -gt 0 ]
            then
                printf 'other: %s\n' "$(printf '%s\n' "$other" | tr '\n' ' ')" | wrap '  '
            fi
        else
            printf '%s\n' "$(printf '%s\n' "$other" | tr '\n' ' ')" | wrap '  '
        fi
        echo "  show: apt list --upgradable"
    fi
    echo "$lists"
    if [ -n "$problem" ]
    then
        printf '%s\n' "$problem" | wrap '  '
    fi
    printf '%s%s\n' "$footer" "$reset"
} | publish "$FILE"
publish "$LAST" < "$FILE"

if [ "$quiet" -eq 0 ]
then
    cat "$FILE"
fi
