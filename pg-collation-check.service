[Unit]
Description=PostgreSQL collation version check for the login warning
Documentation=https://github.com/MarcFauser/pg-collation-check
# postgresql.service waits for all clusters (each postgresql@.service is Before= it).
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pg-collation-check --quiet --trigger boot

[Install]
WantedBy=multi-user.target
