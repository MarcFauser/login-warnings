#!/bin/sh
# pg-collation-check
#
# Checks every local PostgreSQL cluster (15 or newer, online, not a standby) for databases
# whose stored collation version no longer matches the operating system, and writes the
# result to /run/login-warnings/pg-collation. login-warnings shows that file in every
# interactive login shell, as one section of its display. The file always says when the check
# ran: green "OK", the orange "VERSION MISMATCH" with the fix, or an orange "CHECK FAILED"
# followed by the last successful result (kept in /run/login-warnings/.pg-collation.last).
#
# A database counts as affected when its stored version differs from the version the
# running server reports, or - for the libc provider - from the glibc installed on disk.
# The second catches a glibc upgrade before PostgreSQL has been restarted: until then the
# running server still reports the old version.
#
# Runs after every boot, dpkg run and apt update (login-warnings). Run it by hand at any
# time, as root. If a cluster cannot be queried, the exit status is 1 and the login shows the
# failure, so a failed check never looks like an all-clear.
#
# Usage: pg-collation-check [--quiet] [--trigger boot|dpkg|apt|manual]
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

DIR=/run/login-warnings
FILE=$DIR/pg-collation
# Hidden from the login display (its glob skips dot files): the last successful result.
LAST=$DIR/.pg-collation.last

quiet=0
trigger=manual
while [ $# -gt 0 ]
do
    case $1 in
        --quiet) quiet=1 ;;
        --trigger) shift; trigger=${1:-manual} ;;
        *) echo "Usage: pg-collation-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2; exit 2 ;;
    esac
    shift
done

case $trigger in
    boot) checked_by="at boot" ;;
    dpkg) checked_by="after a package change" ;;
    apt) checked_by="after apt update" ;;
    manual) checked_by="by hand" ;;
    *) echo "Usage: pg-collation-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2; exit 2 ;;
esac

if [ "$(id -u)" -ne 0 ]
then
    echo "Please run as root." >&2
    exit 1
fi

query()
{
    timeout 5 runuser -u postgres -- psql -XAtq "port=$1 dbname=postgres connect_timeout=2" -c "$2" 2>/dev/null
}

# The glibc version a freshly started process gets, e.g. 2.41. Only digits and dots are
# accepted, because the value goes into the SQL below.
installed=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{ print $2 }')
case $installed in
    [0-9]*.[0-9]*) ;;
    *) installed="" ;;
esac
case $installed in
    *[!0-9.]*) installed="" ;;
esac

if command -v pg_lsclusters >/dev/null 2>&1
then
    # Standbys report "online,recovery" and are skipped; the primary's reindex reaches them.
    ports=$(pg_lsclusters -h 2>/dev/null | while read -r _ _ port status _
    do
        if [ "$status" = "online" ]
        then
            echo "$port"
        fi
    done)
else
    ports=5432
fi

result=""
failed=""
for port in $ports
do
    if ! version=$(query "$port" "SHOW server_version_num") || [ -z "$version" ]
    then
        failed="$failed $port"
        continue
    fi
    if [ "$version" -lt 150000 ]
    then
        continue
    fi

    if ! rows=$(query "$port" "
        SELECT 'port $port, ' || datname || ': '
               || coalesce(datcollversion, 'none') || ' -> '
               || coalesce(pg_database_collation_actual_version(oid), 'none')
               || CASE WHEN datlocprovider = 'c' AND '$installed' <> ''
                            AND pg_database_collation_actual_version(oid) IS DISTINCT FROM '$installed'
                       THEN ' (glibc on disk: $installed)'
                       ELSE '' END
        FROM pg_database
        WHERE datallowconn
          AND (datcollversion IS DISTINCT FROM pg_database_collation_actual_version(oid)
               OR (datlocprovider = 'c' AND '$installed' <> ''
                   AND datcollversion IS DISTINCT FROM '$installed'))")
    then
        failed="$failed $port"
        continue
    fi
    if [ -n "$rows" ]
    then
        result="$result$rows
"
    fi
done

mkdir -p -m 0755 "$DIR"
checked_at=$(date '+%Y-%m-%d %H:%M:%S %:z')

# Orange (index 208 of the 256-colour palette) for problems, green for the all-clear.
orange=$(printf '\033[38;5;208m')
green=$(printf '\033[32m')
reset=$(printf '\033[0m')

# Writes stdin next to the target and renames it, so a login never shows a half-written file.
publish()
{
    cat > "$1.tmp.$$"
    chmod 0644 "$1.tmp.$$"
    mv -f "$1.tmp.$$" "$1"
}

# The result is one section of the login display: a title line with the state, the details
# indented by two spaces, lines kept below 80 columns, one colour for the whole section.
footer="  checked $checked_at ($checked_by)
  check again: pg-collation-check"

if [ -n "$failed" ]
then
    if [ -s "$LAST" ]
    then
        last="  last successful check:
$(sed 's/^/    /' "$LAST")"
    else
        last="  no successful check since boot"
    fi
    printf '%sPostgreSQL collation: CHECK FAILED\n  could not query the cluster on port(s)%s\n%s\n%s%s\n' \
        "$orange" "$failed" "$footer" "$last" "$reset" | publish "$FILE"
    echo "pg-collation-check: could not query the cluster(s) on port(s)$failed." >&2
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 1
fi

if [ -z "$result" ]
then
    printf '%sPostgreSQL collation: OK\n%s%s\n' "$green" "$footer" "$reset" | publish "$FILE"
    publish "$LAST" < "$FILE"
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 0
fi

# With a newer glibc on disk than the running server uses, a reindex would still sort
# with the old one, and pg-collation-fix compares with the running server.
if printf '%s' "$result" | grep -q '(glibc on disk: '
then
    advice="  PostgreSQL still runs with the old glibc. Reboot first, or restart
  PostgreSQL (systemctl restart postgresql) and run pg-collation-check;
  the warning then shows which databases need the fix."
else
    advice="  To fix, rebuild the indexes and reboot afterwards:
    runuser -u postgres -- /usr/local/sbin/pg-collation-fix
    reboot"
fi

publish "$FILE" <<EOF
${orange}PostgreSQL collation: VERSION MISMATCH
  The collation version of the operating system (glibc) has changed.
  Text indexes may be inconsistent until they are rebuilt.
  Affected databases (stored -> current):
$(printf '%s' "$result" | sed 's/^/    /')
$advice
  While indexes are rebuilt, queries on the affected tables have to wait.
$footer${reset}
EOF
publish "$LAST" < "$FILE"

if [ "$quiet" -eq 0 ]
then
    cat "$FILE"
fi
