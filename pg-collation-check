#!/bin/sh
# pg-collation-check
#
# Checks every local PostgreSQL cluster (15 or newer, online, not a standby) for databases
# whose stored collation version no longer matches the operating system, and writes the
# result to /run/login-warnings/pg-collation. login-warnings shows that file in every
# interactive login shell, as one section of its display. The file always says when the check
# ran: green "OK", the orange "VERSION MISMATCH" with the fix, or an orange "CHECK FAILED"
# followed by the last successful result (kept in /run/login-warnings/.pg-collation.last).
#
# A database counts as affected when its stored version differs from the version the
# running server reports, or - for the libc provider - from the glibc installed on disk.
# The second catches a glibc upgrade before PostgreSQL has been restarted: until then the
# running server still reports the old version.
#
# Two kinds of clusters are checked: those of the Debian and PGDG packages (user postgres,
# ports from pg_lsclusters), and the PostgreSQL bundled with the GitLab Linux package
# (/opt/gitlab, user gitlab-psql), reached through gitlab-psql. GitLab's links against the
# system glibc, so a Debian upgrade affects it the same way. The OK section names the clusters
# that were checked; if none was running, the section says so instead of reporting OK.
#
# Runs after every boot, dpkg run and apt update (login-warnings). Run it by hand at any
# time, as root. If a cluster cannot be queried, the exit status is 1 and the login shows the
# failure, so a failed check never looks like an all-clear.
#
# Usage: pg-collation-check [--quiet] [--trigger boot|dpkg|apt|manual]
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

DIR=/run/login-warnings
FILE=$DIR/pg-collation
# Hidden from the login display (its glob skips dot files): the last successful result.
LAST=$DIR/.pg-collation.last

quiet=0
trigger=manual
while [ $# -gt 0 ]
do
    case $1 in
        --quiet) quiet=1 ;;
        --trigger) shift; trigger=${1:-manual} ;;
        *) echo "Usage: pg-collation-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2; exit 2 ;;
    esac
    shift
done

case $trigger in
    boot) checked_by="at boot" ;;
    dpkg) checked_by="after a package change" ;;
    apt) checked_by="after apt update" ;;
    manual) checked_by="by hand" ;;
    *) echo "Usage: pg-collation-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2; exit 2 ;;
esac

if [ "$(id -u)" -ne 0 ]
then
    echo "Please run as root." >&2
    exit 1
fi

GITLAB_CTL=/opt/gitlab/bin/gitlab-ctl
GITLAB_PSQL=/opt/gitlab/bin/gitlab-psql

# $1 is the port of a Debian/PGDG cluster, or "gitlab" for GitLab's bundled cluster.
query()
{
    if [ "$1" = gitlab ]
    then
        # gitlab-psql drops to the user gitlab-psql and knows socket and port; the -d given here
        # wins over its default database. The connect timeout reaches psql through the environment.
        PGCONNECT_TIMEOUT=2 timeout 5 "$GITLAB_PSQL" -XAtq -d postgres -c "$2" 2>/dev/null
    else
        timeout 5 runuser -u postgres -- psql -XAtq "port=$1 dbname=postgres connect_timeout=2" -c "$2" 2>/dev/null
    fi
}

# The name of a cluster in the display.
label()
{
    if [ "$1" = gitlab ]
    then
        echo GitLab
    else
        echo "port $1"
    fi
}

gitlab_running()
{
    case $(timeout 20 "$GITLAB_CTL" status postgresql 2>/dev/null) in
        run:*) return 0 ;;
    esac
    return 1
}

# The glibc version a freshly started process gets, e.g. 2.41. Only digits and dots are
# accepted, because the value goes into the SQL below.
installed=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{ print $2 }')
case $installed in
    [0-9]*.[0-9]*) ;;
    *) installed="" ;;
esac
case $installed in
    *[!0-9.]*) installed="" ;;
esac

targets=""
if id postgres >/dev/null 2>&1 && command -v psql >/dev/null 2>&1
then
    if command -v pg_lsclusters >/dev/null 2>&1
    then
        # Standbys report "online,recovery" and are skipped; the primary's reindex reaches them.
        targets=$(pg_lsclusters -h 2>/dev/null | while read -r _ _ port status _
        do
            if [ "$status" = "online" ]
            then
                echo "$port"
            fi
        done)
    else
        targets=5432
    fi
fi

# GitLab's bundled PostgreSQL is enabled when runit supervises it. A stopped one is skipped
# like an offline Debian cluster, except at boot: login-warnings.service starts after
# gitlab-runsvdir.service, but runit starts PostgreSQL only then, so wait up to 60 seconds for
# it to answer; if it does not, the check fails instead of reporting OK without it.
if [ -x "$GITLAB_CTL" ] && [ -x "$GITLAB_PSQL" ] && [ -e /opt/gitlab/service/postgresql ]
then
    if [ "$trigger" = boot ]
    then
        deadline=$(( $(date +%s) + 60 ))
        until { gitlab_running && query gitlab "SELECT 1" >/dev/null; } || [ "$(date +%s)" -ge "$deadline" ]
        do
            sleep 2
        done
        targets="$targets gitlab"
    elif gitlab_running
    then
        targets="$targets gitlab"
    fi
fi

result=""
failed=""
checked=""
for target in $targets
do
    name=$(label "$target")
    if ! version=$(query "$target" "SHOW server_version_num") || [ -z "$version" ]
    then
        failed="$failed, $name"
        continue
    fi
    if [ "$version" -lt 150000 ]
    then
        continue
    fi

    if ! rows=$(query "$target" "
        SELECT '$name, ' || datname || ': '
               || coalesce(datcollversion, 'none') || ' -> '
               || coalesce(pg_database_collation_actual_version(oid), 'none')
               || CASE WHEN datlocprovider = 'c' AND '$installed' <> ''
                            AND pg_database_collation_actual_version(oid) IS DISTINCT FROM '$installed'
                       THEN ' (glibc on disk: $installed)'
                       ELSE '' END
        FROM pg_database
        WHERE datallowconn
          AND (datcollversion IS DISTINCT FROM pg_database_collation_actual_version(oid)
               OR (datlocprovider = 'c' AND '$installed' <> ''
                   AND datcollversion IS DISTINCT FROM '$installed'))")
    then
        failed="$failed, $name"
        continue
    fi
    checked="$checked, $name"
    if [ -n "$rows" ]
    then
        result="$result$rows
"
    fi
done
failed=${failed#, }
checked=${checked#, }

mkdir -p -m 0755 "$DIR"
checked_at=$(date '+%Y-%m-%d %H:%M:%S %:z')

# Orange (index 208 of the 256-colour palette) for problems, green for the all-clear.
orange=$(printf '\033[38;5;208m')
green=$(printf '\033[32m')
reset=$(printf '\033[0m')

# Writes stdin next to the target and renames it, so a login never shows a half-written file.
publish()
{
    cat > "$1.tmp.$$"
    chmod 0644 "$1.tmp.$$"
    mv -f "$1.tmp.$$" "$1"
}

# The result is one section of the login display: a title line with the state, the details
# indented by two spaces, lines kept below 80 columns, one colour for the whole section.
footer="  checked $checked_at ($checked_by)
  check again: pg-collation-check"

if [ -n "$failed" ]
then
    if [ -s "$LAST" ]
    then
        last="  last successful check:
$(sed 's/^/    /' "$LAST")"
    else
        last="  no successful check since boot"
    fi
    printf '%sPostgreSQL collation: CHECK FAILED\n  could not query: %s\n%s\n%s%s\n' \
        "$orange" "$failed" "$footer" "$last" "$reset" | publish "$FILE"
    echo "pg-collation-check: could not query: $failed." >&2
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 1
fi

# An OK over no cluster at all would look like an all-clear; it is said instead.
if [ -z "$checked" ]
then
    printf '%sPostgreSQL collation: NOTHING CHECKED\n  no running PostgreSQL 15 or newer was found\n%s%s\n' \
        "$orange" "$footer" "$reset" | publish "$FILE"
    publish "$LAST" < "$FILE"
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 0
fi

if [ -z "$result" ]
then
    printf '%sPostgreSQL collation: OK\n  clusters: %s\n%s%s\n' "$green" "$checked" "$footer" "$reset" \
        | publish "$FILE"
    publish "$LAST" < "$FILE"
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
    exit 0
fi

debian_affected=0
gitlab_affected=0
if printf '%s' "$result" | grep -q '^port '
then
    debian_affected=1
fi
if printf '%s' "$result" | grep -q '^GitLab, '
then
    gitlab_affected=1
fi

# With a newer glibc on disk than the running server uses, a reindex would still sort
# with the old one, and pg-collation-fix compares with the running server.
if printf '%s' "$result" | grep -q '(glibc on disk: '
then
    advice="  PostgreSQL still runs with the old glibc. Reboot first, or restart it
  and run pg-collation-check; the warning then shows what needs the fix:"
    if [ "$debian_affected" -eq 1 ]
    then
        advice="$advice
    systemctl restart postgresql"
    fi
    if [ "$gitlab_affected" -eq 1 ]
    then
        advice="$advice
    gitlab-ctl restart postgresql"
    fi
else
    advice=""
    if [ "$debian_affected" -eq 1 ]
    then
        advice="  To fix, rebuild the indexes and reboot afterwards:
    runuser -u postgres -- /usr/local/sbin/pg-collation-fix
    reboot"
    fi
    # GitLab's procedure: stop everything but its PostgreSQL, rebuild, start again
    # (docs.gitlab.com, administration/postgresql/upgrading_os, "Rebuild all indexes").
    if [ "$gitlab_affected" -eq 1 ]
    then
        if [ -n "$advice" ]
        then
            advice="$advice
"
        fi
        advice="$advice  For GitLab, stop it except PostgreSQL, rebuild, start it again:
    gitlab-ctl stop && gitlab-ctl start postgresql
    /usr/local/sbin/pg-collation-fix --gitlab
    gitlab-ctl start && pg-collation-check"
    fi
fi

publish "$FILE" <<EOF
${orange}PostgreSQL collation: VERSION MISMATCH
  The collation version of the operating system (glibc) has changed.
  Text indexes may be inconsistent until they are rebuilt.
  Affected databases (stored -> current):
$(printf '%s' "$result" | sed 's/^/    /')
$advice
  While indexes are rebuilt, queries on the affected tables have to wait.
$footer${reset}
EOF
publish "$LAST" < "$FILE"

if [ "$quiet" -eq 0 ]
then
    cat "$FILE"
fi
