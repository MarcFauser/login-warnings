#!/bin/sh
# ssh-password-check
#
# Reports whether the SSH server lets anyone log in with a password, and writes the result to
# /run/login-warnings/ssh-password; login-warnings shows that file in every interactive login
# shell, as one section of its display. The file always says when the check ran: green "OFF",
# an orange "ON" or "ON AFTER RESTART" with where the setting comes from and how to switch it
# off, or an orange "CHECK FAILED" followed by the last successful result (kept in
# /run/login-warnings/.ssh-password.last).
#
# sshd reads its configuration when it starts, so the check asks two sources:
# - The running sshd. The check connects to it on the local address it listens on and asks
#   which authentication methods it offers, with the "none" request every SSH client sends
#   first. Nothing logs in; sshd logs "Connection closed by authenticating user root ...".
# - The configuration on disk: sshd -T, evaluated for the same connection (root from that
#   address). sshd's debug output names the file and line each setting comes from.
# Password login counts as on when sshd offers "password" or "keyboard-interactive" (with PAM,
# that asks for the password as well). When the two sources differ, sshd has not been
# restarted since its configuration changed.
#
# Match blocks change settings per user, group, address or host. The check evaluates them only
# for root from the local address, so the section lists every Match block it finds.
#
# Runs after every boot, dpkg run and apt update (login-warnings). Run it by hand at any time,
# as root. If sshd cannot be asked, the exit status is 1 and the login shows the failure.
#
# Usage: ssh-password-check [--quiet] [--trigger boot|dpkg|apt|manual]
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

DIR=/run/login-warnings
FILE=$DIR/ssh-password
# Hidden from the login display: the last successful result.
LAST=$DIR/.ssh-password.last
# The file the section suggests for "keys only". Debian's sshd_config includes
# /etc/ssh/sshd_config.d/*.conf near its top, and sshd keeps the first value it reads.
DROPIN=/etc/ssh/sshd_config.d/10-key-only.conf

usage()
{
    echo "Usage: ssh-password-check [--quiet] [--trigger boot|dpkg|apt|manual]" >&2
    exit 2
}

quiet=0
trigger=manual
while [ $# -gt 0 ]
do
    case $1 in
        --quiet) quiet=1 ;;
        --trigger) shift; trigger=${1:-} ;;
        *) usage ;;
    esac
    shift
done

case $trigger in
    boot) checked_by="at boot" ;;
    dpkg) checked_by="after a package change" ;;
    apt) checked_by="after apt update" ;;
    manual) checked_by="by hand" ;;
    *) usage ;;
esac

if [ "$(id -u)" -ne 0 ]
then
    echo "Please run as root." >&2
    exit 1
fi

mkdir -p -m 0755 "$DIR"
checked_at=$(date '+%Y-%m-%d %H:%M:%S %:z')

# Orange (index 208 of the 256-colour palette) for problems, green for the all-clear.
orange=$(printf '\033[38;5;208m')
green=$(printf '\033[32m')
reset=$(printf '\033[0m')

# Writes stdin next to the target and renames it, so a login never shows a half-written file.
publish()
{
    cat > "$1.tmp.$$"
    chmod 0644 "$1.tmp.$$"
    mv -f "$1.tmp.$$" "$1"
}

# Text wrapped and indented by the given prefix. 72 columns, because a failed check shows the
# last result indented by four more, and that must stay below 80 as well.
wrap()
{
    fold -s -w 72 | sed 's/ *$//' | sed "s/^/$1/"
}

show()
{
    if [ "$quiet" -eq 0 ]
    then
        cat "$FILE"
    fi
}

# The result is one section of the login display: a title line with the state, the details
# indented by two spaces, lines kept below 80 columns, one colour for the whole section.
footer="  checked $checked_at ($checked_by)
  check again: ssh-password-check"

# Writes CHECK FAILED with the reason (already indented) and the last successful result.
fail()
{
    if [ -s "$LAST" ]
    then
        last="  last successful check:
$(sed 's/^/    /' "$LAST")"
    else
        last="  no successful check since boot"
    fi
    printf '%sSSH password login: CHECK FAILED\n%s\n%s\n%s%s\n' \
        "$orange" "$1" "$footer" "$last" "$reset" | publish "$FILE"
    echo "ssh-password-check: $(printf '%s\n' "$1" | head -n 1 | sed 's/^ *//')" >&2
    show
    exit 1
}

# Without an SSH server there is nothing to log in to; said instead of an OK over nothing.
if ! command -v sshd >/dev/null 2>&1
then
    printf '%sSSH password login: NOTHING CHECKED\n  no SSH server installed (sshd, package openssh-server)\n  switch the check off: login-warnings disable ssh-password\n%s%s\n' \
        "$orange" "$footer" "$reset" | publish "$FILE"
    publish "$LAST" < "$FILE"
    show
    exit 0
fi
if ! command -v ssh >/dev/null 2>&1
then
    fail "  the SSH client (ssh, package openssh-client) is missing; it asks sshd"
fi

# The effective configuration on disk. It fails when sshd would not start with it.
if ! global=$(timeout 10 sshd -T 2>&1)
then
    fail "  sshd -T failed, sshd would not start with this configuration:
$(printf '%s\n' "$global" | tr -d '\r' | grep -v '^debug' | head -n 3 | wrap '    ')"
fi

# Where to ask the running sshd: the loopback address of a wildcard listener, IPv4 first,
# otherwise the first address it listens on.
target=$(printf '%s\n' "$global" | awk '
    $1 == "listenaddress" {
        port = $2; sub(/.*:/, "", port)
        host = $2; sub(/:[0-9]+$/, "", host); gsub(/[][]/, "", host)
        if (host == "0.0.0.0") { if (v4 == "") v4 = "127.0.0.1 " port }
        else if (host == "::") { if (v6 == "") v6 = "::1 " port }
        else if (other == "") other = host " " port
    }
    END { if (v4 != "") print v4; else if (v6 != "") print v6; else print other }')
addr=${target% *}
port=${target##* }
case $port in
    '' | *[!0-9]*) fail "  sshd -T names no address it listens on" ;;
esac
case $addr in
    '' | *[!0-9A-Za-z.:%-]*) fail "  sshd -T names no usable listen address ($addr)" ;;
esac

# The configuration for the same connection the check makes, and sshd's debug output for it:
# "<file>:<line> setting <keyword> <value>" for every setting it reads outside Match blocks
# (before the line "config reprocess config"), and "checking syntax for 'Match ...'" for every
# Match block (OpenSSH 10.0, measured 2026-11-14).
conn="user=root,host=$addr,addr=$addr,laddr=$addr,lport=$port"
if ! disk=$(timeout 10 sshd -T -C "$conn" 2>&1)
then
    fail "  sshd -T -C $conn failed:
$(printf '%s\n' "$disk" | tr -d '\r' | head -n 3 | wrap '    ')"
fi
# sshd ends every message it logs to stderr with CR LF (log.c of OpenSSH 10.0p2, line 409,
# "%s%s%.*s\r\n"), so the CR goes first, as for the ssh client below.
debug=$(timeout 10 sshd -T -ddd -C "$conn" 2>&1 >/dev/null | tr -d '\r')

value()
{
    printf '%s\n' "$disk" | awk -v k="$1" '$1 == k { print $2; exit }'
}
disk_password=$(value passwordauthentication)
disk_kbd=$(value kbdinteractiveauthentication)
disk_root=$(value permitrootlogin)

# Ask the running sshd. Nothing is read from or written to root's SSH configuration or
# known_hosts, and no key or agent is offered. ssh ends its messages on stderr with CR LF
# ("Permission denied (publickey).\r\n", measured 2026-11-14), so the CR goes first.
probe=$(timeout 15 ssh -F none -T -o BatchMode=yes -o PreferredAuthentications=none \
    -o IdentityAgent=none -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=5 -o LogLevel=ERROR \
    -p "$port" "root@$addr" true 2>&1 < /dev/null)
probe_status=$?
probe=$(printf '%s\n' "$probe" | tr -d '\r')
methods=$(printf '%s\n' "$probe" | sed -n 's/.*Permission denied (\(.*\))\.$/\1/p' | tail -n 1)
if [ "$probe_status" -eq 0 ]
then
    # "none" only succeeds for an account with an empty password (PermitEmptyPasswords).
    methods=none
elif [ -z "$methods" ]
then
    if [ -z "$probe" ]
    then
        probe="no output, exit status $probe_status"
    fi
    fail "  no list of authentication methods from sshd at $addr port $port:
$(printf '%s\n' "$probe" | head -n 2 | wrap '    ')"
fi

running=0
case ",$methods," in
    *,password,* | *,keyboard-interactive,* | ,none,) running=1 ;;
esac
on_disk=0
if [ "$disk_password" = yes ] || [ "$disk_kbd" = yes ]
then
    on_disk=1
fi

# Where an effective "yes" comes from: the first file and line that sets it outside Match
# blocks, sshd's default, or a Match block that applies to this connection.
source_of()
{
    found=$(printf '%s\n' "$debug" | awk -v k="$2" -v alias="$3" '
        /config reprocess config/ { exit }
        $1 == "debug3:" && $3 == "setting" {
            kw = tolower($4)
            if (kw == k || (alias != "" && kw == alias)) { print $5 " " $2; exit }
        }')
    case $found in
        '') echo "  $1 yes: not set, sshd's default" ;;
        yes\ *) printf '  %s yes, set in\n    %s\n' "$1" "${found#yes }" ;;
        *) echo "  $1 yes: set by a Match block" ;;
    esac
}

# Whether writing $DROPIN switches the settings off, for the settings given (sshd -T spelling)
# that are yes. sshd reads an Include's files in the order glob(3) sorts them, which is the C
# locale because sshd sets none, and announces each one ("<file> line <n>: including <path>",
# or "no match for <glob>"). The first value of a setting wins, so $DROPIN helps if sshd would
# read it before the line that sets yes. Prints the verdict that decides the advice:
#   new                   $DROPIN would be read first
#   before <file>:<line>  that line is read before $DROPIN would be
#   match                 a Match block sets the value for this connection
#   noinclude             no Include reads $DROPIN
#   unknown               an Include after a Match line, or a glob with brackets
fix_verdict()
{
    printf '%s\n' "$debug" | LC_ALL=C awk -v dropin="$DROPIN" -v want="$*" '
        function glob_re(g,    r, i, c)
        {
            r = "^"
            for (i = 1; i <= length(g); i++) {
                c = substr(g, i, 1)
                if (c == "*") r = r "[^/]*"
                else if (c == "?") r = r "[^/]"
                else if (c == "[") return ""
                else if (index("\\^$.|+(){}", c)) r = r "\\" c
                else r = r c
            }
            return r "$"
        }
        BEGIN {
            nw = split(want, w, " ")
            for (i = 1; i <= nw; i++) wanted[w[i]] = 1
            # 0: before the Include that would read dropin, 1: inside it, before the place
            # of dropin, 2: after that place
            state = 0
        }
        /config reprocess config/ { exit }
        /^debug3: checking syntax for .Match / { if (!inc) matchfirst = 1; next }
        $1 == "debug2:" && index($0, ": new include ") {
            if (inc) next
            s = substr($0, 9)
            p = index(s, ": new include ")
            re = glob_re(substr(s, p + 14))
            if (re == "") { unknown = 1; next }
            if (dropin !~ re) next
            inc = 1
            incat = substr(s, 1, p - 1)
            ifile = incat; sub(/ line [0-9]+$/, "", ifile)
            iline = incat; sub(/.* line /, "", iline)
            if (matchfirst) unknown = 1
            state = 1
            next
        }
        state == 1 && $1 == "debug2:" && index($0, incat ": including ") == 9 {
            if (substr($0, 9 + length(incat ": including ")) > dropin) state = 2
            next
        }
        $1 == "debug3:" && $3 == "setting" {
            f = $2; sub(/:[0-9]+$/, "", f)
            l = $2; sub(/.*:/, "", l)
            if (state == 1 && f == ifile && l + 0 > iline + 0) state = 2
            k = tolower($4)
            if (k == "challengeresponseauthentication") k = "kbdinteractiveauthentication"
            if ((k in wanted) && !(k in seen)) {
                seen[k] = 1; val[k] = $5; pos[k] = state; src[k] = $2
            }
        }
        END {
            best = "new"; rank = 0
            for (i = 1; i <= nw; i++) {
                k = w[i]
                if (unknown) { v = "unknown"; r = 4 }
                else if ((k in seen) && val[k] != "yes") { v = "match"; r = 3 }
                else if ((k in seen) && pos[k] < 2) { v = "before " src[k]; r = 2 }
                else if (!inc) { v = "noinclude"; r = 1 }
                else { v = "new"; r = 0 }
                if (r > rank) { best = v; rank = r }
            }
            print best
        }'
}

# The advice for one verdict: what to change (wrapped), the file or line on its own line, the
# reason (wrapped), and the command that applies it.
advise()
{
    add "$(printf '%s\n' "$1" | wrap '  ')"
    if [ -n "$2" ]
    then
        add "    $2"
    fi
    if [ -n "$3" ]
    then
        add "$(printf '%s\n' "$3" | wrap '  ')"
    fi
    add "    sshd -t && systemctl restart ssh && ssh-password-check"
}

details=""
add()
{
    details="$details$1
"
}

if [ "$methods" = none ]
then
    add "  root got in from $addr with an empty password (PermitEmptyPasswords)"
else
    add "  sshd offers: $(printf '%s' "$methods" | sed 's/,/, /g')"
fi

if [ "$on_disk" -eq 1 ]
then
    if [ "$running" -eq 0 ]
    then
        add "$(printf '%s\n' "The configuration on disk allows passwords; sshd uses it when it restarts, at the latest at the next boot." | wrap '  ')"
    fi
    add "  every account that has a password can log in with it"
    case $disk_root in
        yes) add "  root too (PermitRootLogin yes)" ;;
        no) add "  root cannot log in at all (PermitRootLogin no)" ;;
        without-password | prohibit-password) add "  root: key only (PermitRootLogin prohibit-password)" ;;
        *) add "  root: PermitRootLogin $disk_root" ;;
    esac
    if [ "$disk_password" = yes ]
    then
        add "$(source_of PasswordAuthentication passwordauthentication)"
    fi
    if [ "$disk_kbd" = yes ]
    then
        add "$(source_of KbdInteractiveAuthentication kbdinteractiveauthentication challengeresponseauthentication)"
    fi
    yes_keys=""
    if [ "$disk_password" = yes ]
    then
        yes_keys=passwordauthentication
    fi
    if [ "$disk_kbd" = yes ]
    then
        yes_keys="$yes_keys kbdinteractiveauthentication"
    fi
    verdict=$(fix_verdict $yes_keys)
    if [ "$verdict" = new ] && [ -e "$DROPIN" ]
    then
        verdict=exists
    fi
    # The command is split with backslashes, so that every line stays below 80 columns and
    # the lines can be copied together.
    set_both="To allow keys only, check that a key login works, then set PasswordAuthentication and KbdInteractiveAuthentication to no"
    case $verdict in
        new)
            add "  To allow keys only, check that a key login works, then run:
    printf '%s\\n' 'PasswordAuthentication no' \\
        'KbdInteractiveAuthentication no' \\
        > $DROPIN
    sshd -t && systemctl restart ssh && ssh-password-check"
            ;;
        exists)
            advise "$set_both in" "$DROPIN" "(it exists already; sshd keeps the first value it reads), then run:"
            ;;
        before\ *)
            advise "To allow keys only, check that a key login works, then change" "${verdict#before }" \
                "to no (sshd reads that line before $DROPIN would be read, and keeps the first value it reads), then run:"
            ;;
        match)
            advise "$set_both in the Match block that sets them (listed below), then run:" "" ""
            ;;
        noinclude)
            advise "$set_both in" /etc/ssh/sshd_config \
                "above any Match block (no Include reads $DROPIN, and sshd keeps the first value it reads), then run:"
            ;;
        *)
            advise "$set_both where sshd reads them first, e.g. in" "$DROPIN" \
                "(sshd keeps the first value it reads), then run:"
            ;;
    esac
    add "  meant to be on? login-warnings disable ssh-password"
elif [ "$running" -eq 1 ]
then
    add "$(printf '%s\n' "The configuration on disk allows keys only, but sshd still runs with the old one. Apply it:" | wrap '  ')"
    add "    sshd -t && systemctl restart ssh && ssh-password-check"
fi

# Match blocks can allow passwords for other users, groups or addresses.
matches=$(printf '%s\n' "$debug" | sed -n "s/^debug3: checking syntax for '\\(Match .*\\)' on line [0-9]*\$/\\1/p")
if [ -n "$matches" ]
then
    count=$(printf '%s\n' "$matches" | grep -c .)
    add "  Match blocks, checked only for root from $addr:"
    add "$(printf '%s\n' "$matches" | head -n 5 | cut -c 1-70 | sed 's/^/    /')"
    if [ "$count" -gt 5 ]
    then
        add "    ... and $((count - 5)) more (sshd -T -ddd 2>&1 | grep Match)"
    fi
fi

if [ "$running" -eq 1 ]
then
    colour=$orange
    title="SSH password login: ON"
elif [ "$on_disk" -eq 1 ]
then
    colour=$orange
    title="SSH password login: ON AFTER RESTART"
else
    colour=$green
    title="SSH password login: OFF"
fi

printf '%s%s\n%s%s%s\n' "$colour" "$title" "$details" "$footer" "$reset" | publish "$FILE"
publish "$LAST" < "$FILE"
show
