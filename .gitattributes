# Git never converts line endings - not on commit, not on checkout. Files are
# stored and restored byte for byte, no matter how core.autocrlf is set on the
# machine doing the work. Line endings are content, and keeping them correct is
# the writing tool's job, not git's. The shell scripts need LF; the pre-commit
# hook in _git_hooks refuses a commit that would store one with CRLF.
#
# -text switches off conversion only, not diffing: the diff attribute stays
# unspecified, so git still detects binary files by itself.
* -text

# Left out of the release archive (git archive), which holds only what a server needs.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/_git_hooks export-ignore
/install-git-hooks.cmd export-ignore
/install-git-hooks.ps1 export-ignore
